    <div class="mb-10 text-center">
        <div class="text-3xl font-bold bg-gradient-to-r from-indigo-600 to-indigo-400 bg-clip-text text-transparent">
            AnyDrop
        </div>
        <div class="text-sm text-gray-400 dark:text-gray-500 mt-1.5">@L["AuthLayout_Subtitle"]</div>
