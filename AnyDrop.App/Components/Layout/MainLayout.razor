@inherits LayoutComponentBase
@inject AppEventBus EventBus
@inject NavigationManager Nav
@inject IConnectivityService Connectivity
@inject ISignalRService SignalR
@implements IDisposable

<div class="flex flex-col h-screen bg-gray-50 dark:bg-gray-900 overflow-hidden">
    @if (_showOfflineBanner)
    {
        <div class="status-banner bg-yellow-500 text-white">
            📡 无网络连接
        </div>
    }
    @if (_signalRDisconnected)
    {
        <div class="status-banner bg-orange-400 text-white">
            🔄 实时连接断开，正在重连...
        </div>
    }

    <main class="flex-1 overflow-hidden flex flex-col">
        @Body
    </main>

    <nav class="bg-white/80 dark:bg-gray-800/80 glass border-t border-gray-200/50 dark:border-gray-700/50 flex justify-around items-center h-14 safe-area-bottom">
        <NavLink href="/" Match="NavLinkMatch.All" class="flex flex-col items-center text-xs gap-0.5" ActiveClass="nav-item-active" InactiveClass="nav-item-inactive">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 12l8.954-8.955a1.126 1.126 0 011.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75M8.25 21h8.25" />
            </svg>
            <span>主页</span>
        </NavLink>
        <NavLink href="/search" class="flex flex-col items-center text-xs gap-0.5" ActiveClass="nav-item-active" InactiveClass="nav-item-inactive">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
            </svg>
            <span>搜索</span>
        </NavLink>
        <NavLink href="/settings" class="flex flex-col items-center text-xs gap-0.5" ActiveClass="nav-item-active" InactiveClass="nav-item-inactive">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            <span>设置</span>
        </NavLink>
    </nav>
</div>

@code {
    private bool _showOfflineBanner;
    private bool _signalRDisconnected;

    protected override void OnInitialized()
    {
        EventBus.AuthExpired += OnAuthExpired;
        EventBus.ConnectivityChanged += OnConnectivityChanged;
        SignalR.StateChanged += OnSignalRStateChanged;
        _showOfflineBanner = !Connectivity.IsOnline;
        _signalRDisconnected = SignalR.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected;
    }

    private void OnAuthExpired()
    {
        InvokeAsync(() =>
        {
            Nav.NavigateTo("/login", forceLoad: false);
        });
    }

    private void OnConnectivityChanged(bool isOnline)
    {
        InvokeAsync(() =>
        {
            _showOfflineBanner = !isOnline;
            StateHasChanged();
        });
    }

    private void OnSignalRStateChanged(Microsoft.AspNetCore.SignalR.Client.HubConnectionState state)
    {
        InvokeAsync(() =>
        {
            _signalRDisconnected = state == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EventBus.AuthExpired -= OnAuthExpired;
        EventBus.ConnectivityChanged -= OnConnectivityChanged;
        SignalR.StateChanged -= OnSignalRStateChanged;
    }
}

