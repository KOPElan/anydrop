@inherits LayoutComponentBase
@inject AppEventBus EventBus
@inject NavigationManager Nav
@inject ISignalRService SignalR
@inject IStringLocalizer<AppStrings> L
@implements IDisposable

<div class="flex flex-col h-screen bg-gray-50 dark:bg-gray-900 overflow-hidden">
    @if (_connectionState == ConnectionState.Offline)
    {
        <div class="status-banner bg-yellow-500 text-white">
            @L["Layout_OfflineBanner"]
        </div>
    }
    @if (_connectionState == ConnectionState.Reconnecting)
    {
        <div class="status-banner bg-orange-400 text-white">
            @L["Layout_ReconnectingBanner"]
        </div>
    }

    <main class="flex-1 overflow-hidden flex flex-col">
        @Body
    </main>
</div>

@code {
    // S3-06：横幅直接按应用级连接状态显示（Hub 状态 + 网络连通性 + 是否曾经连通过，
    // 推导在 SignalRService 里）；本页不再自己拼三个输入，也不再区分“首次连接前”。
    private ConnectionState _connectionState = ConnectionState.NeverConnected;

    protected override void OnInitialized()
    {
        EventBus.AuthExpired += OnAuthExpired;
        SignalR.ConnectionStateChanged += OnConnectionStateChanged;
        _connectionState = SignalR.ConnectionState;
    }

    private void OnAuthExpired()
    {
        InvokeAsync(() =>
        {
            Nav.NavigateTo("/login", forceLoad: false);
        });
    }

    private void OnConnectionStateChanged(ConnectionState state)
    {
        InvokeAsync(() =>
        {
            _connectionState = state;
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        EventBus.AuthExpired -= OnAuthExpired;
        SignalR.ConnectionStateChanged -= OnConnectionStateChanged;
    }
}

