@page "/image-preview/{Id}"
@layout AuthLayout
@inject IServerConfigService ServerConfig
@inject ISecureTokenStorage TokenStorage
@inject NavigationManager Nav

<div class="fixed inset-0 bg-black z-50 flex items-center justify-center touch-action-pinch-zoom">
    <button @onclick="GoBack"
            class="absolute top-4 right-4 z-10 w-10 h-10 rounded-full bg-white/10 backdrop-blur flex items-center justify-center text-white active:bg-white/20 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
        </svg>
    </button>
    <img src="@_imageUrl" alt="preview" class="max-w-full max-h-full object-contain" />
</div>

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private string _imageUrl = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        var baseUrl = ServerConfig.GetBaseUrl();
        if (string.IsNullOrWhiteSpace(baseUrl))
        {
            _imageUrl = string.Empty;
            return;
        }

        var token = await TokenStorage.GetTokenAsync().ConfigureAwait(false);
        var query = string.IsNullOrWhiteSpace(token)
            ? string.Empty
            : $"?access_token={Uri.EscapeDataString(token)}";

        _imageUrl = $"{baseUrl}/api/v1/share-items/{Id}/file{query}";
    }

    private void GoBack() => Nav.NavigateTo("/");
}
