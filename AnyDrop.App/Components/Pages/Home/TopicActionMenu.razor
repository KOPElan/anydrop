@inject ITopicService TopicService
@inject IAppStateService AppState
@inject IStringLocalizer<AppStrings> L

@if (_showMenu && Topic is not null)
{
    <div class="fixed inset-0 z-50 flex items-end justify-center bg-black/50" @onclick="() => OnClose.InvokeAsync()">
        <div class="bg-white dark:bg-gray-800 rounded-t-2xl w-full max-w-lg p-4 space-y-1" @onclick:stopPropagation="true">
            <div class="text-center font-medium text-gray-800 dark:text-gray-100 py-2 flex items-center justify-center gap-2">
                <span class="material-symbols-outlined">@Topic.Icon</span>
                <span>@Topic.Name</span>
            </div>
            <hr class="border-gray-200 dark:border-gray-700" />

            @if (_editMode)
            {
                <div class="py-2 space-y-2">
                    <input @bind="_editName" type="text"
                           class="w-full px-3 py-2 rounded-lg border border-gray-300 dark:border-gray-600 bg-white dark:bg-gray-700 text-sm text-gray-900 dark:text-gray-100 focus:outline-none focus:ring-2 focus:ring-blue-500" />
                    <div class="flex gap-2">
                        <button @onclick="() => _editMode = false" class="flex-1 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm">@L["Common_Cancel"]</button>
                        <button @onclick="RenameAsync" class="flex-1 py-2 bg-blue-500 text-white rounded-lg text-sm font-medium">@L["Common_Save"]</button>
                    </div>
                </div>
            }
            else if (_iconMode)
            {
                <div class="py-2 space-y-3">
                    <div class="grid grid-cols-5 gap-2">
                        @foreach (var icon in _availableIcons)
                        {
                            <button @onclick="() => _selectedIcon = icon"
                                    class="h-10 rounded-lg border transition-colors @(icon == _selectedIcon ? "border-blue-500 bg-blue-50 dark:bg-blue-900/30" : "border-gray-200 dark:border-gray-700")">
                                <span class="material-symbols-outlined text-[20px] text-gray-700 dark:text-gray-200">@icon</span>
                            </button>
                        }
                    </div>
                    <div class="flex gap-2">
                        <button @onclick="() => _iconMode = false" class="flex-1 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm">@L["Common_Cancel"]</button>
                        <button @onclick="SaveIconAsync" class="flex-1 py-2 bg-blue-500 text-white rounded-lg text-sm font-medium">@L["TopicAction_SaveIcon"]</button>
                    </div>
                </div>
            }
            else if (_confirmDelete)
            {
                <div class="py-2 space-y-2">
                    <p class="text-sm text-gray-600 dark:text-gray-400 text-center">@string.Format(L["TopicAction_ConfirmDelete"], Topic.Name)</p>
                    <div class="flex gap-2">
                        <button @onclick="() => _confirmDelete = false" class="flex-1 py-2 border border-gray-300 dark:border-gray-600 rounded-lg text-sm">@L["Common_Cancel"]</button>
                        <button @onclick="DeleteAsync" class="flex-1 py-2 bg-red-600 text-white rounded-lg text-sm font-medium">@L["Common_Delete"]</button>
                    </div>
                </div>
            }
            else
            {
                <ActionItem Icon="edit" Label="@L["TopicAction_Rename"]" OnClick="() => { _editMode = true; _editName = Topic.Name; }" />
                <ActionItem Icon="image" Label="@L["TopicAction_SetIcon"]" OnClick="OpenIconMode" />
                <ActionItem Icon="@(Topic.IsPinned ? "keep_off" : "keep")" Label="@(Topic.IsPinned ? L["TopicAction_Unpin"] : L["TopicAction_Pin"])" OnClick="TogglePinAsync" />
                <ActionItem Icon="@(Topic.IsArchived ? "unarchive" : "archive")" Label="@(Topic.IsArchived ? L["TopicAction_Unarchive"] : L["TopicAction_Archive"])" OnClick="ToggleArchiveAsync" />
                @if (OnEnterSelectionMode.HasDelegate)
                {
                    <ActionItem Icon="checklist" Label="@L["TopicAction_SelectMessages"]" OnClick="SelectMessagesAsync" />
                }
                <ActionItem Icon="delete" Label="@L["Common_Delete"]" OnClick="() => _confirmDelete = true" Danger="true" />
            }
        </div>
    </div>
}

@code {
    [Parameter] public TopicDto? Topic { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback OnTopicChanged { get; set; }
    [Parameter] public EventCallback OnEnterSelectionMode { get; set; }

    private bool _showMenu = true;
    private bool _editMode;
    private bool _iconMode;
    private bool _confirmDelete;
    private string _editName = string.Empty;
    private string _selectedIcon = "chat_bubble";

    private static readonly string[] _availableIcons =
    [
        "chat_bubble", "bookmark", "work", "home", "favorite",
        "school", "sports_esports", "code", "music_note", "restaurant",
        "flight", "local_cafe", "shopping_cart", "cake", "pets",
        "directions_car", "movie", "explore", "star", "lightbulb",
        "beach_access", "fitness_center", "palette", "public", "emoji_events"
    ];

    protected override void OnParametersSet()
    {
        _selectedIcon = Topic?.Icon ?? "chat_bubble";
    }

    private async Task SelectMessagesAsync()
    {
        await OnClose.InvokeAsync();
        await OnEnterSelectionMode.InvokeAsync();
    }

    private void OpenIconMode()
    {
        _iconMode = true;
        _selectedIcon = Topic?.Icon ?? "chat_bubble";
    }

    private async Task RenameAsync()
    {
        if (Topic is null || string.IsNullOrWhiteSpace(_editName)) return;
        await TopicService.UpdateTopicAsync(Topic.Id, new UpdateTopicRequest(_editName));
        _editMode = false;
        await OnTopicChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task TogglePinAsync()
    {
        if (Topic is null) return;
        await TopicService.PinTopicAsync(Topic.Id, new PinTopicRequest(!Topic.IsPinned));
        await OnTopicChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task ToggleArchiveAsync()
    {
        if (Topic is null) return;
        await TopicService.ArchiveTopicAsync(Topic.Id, new ArchiveTopicRequest(!Topic.IsArchived));
        await OnTopicChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task SaveIconAsync()
    {
        if (Topic is null || string.IsNullOrWhiteSpace(_selectedIcon)) return;
        await TopicService.UpdateTopicIconAsync(Topic.Id, new UpdateTopicIconRequest(_selectedIcon));
        _iconMode = false;
        await OnTopicChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private async Task DeleteAsync()
    {
        if (Topic is null) return;
        await TopicService.DeleteTopicAsync(Topic.Id);
        var existing = AppState.Topics.FirstOrDefault(t => t.Id == Topic.Id);
        if (existing is not null) AppState.Topics.Remove(existing);
        AppState.NotifyStateChanged();
        _confirmDelete = false;
        await OnTopicChanged.InvokeAsync();
        await OnClose.InvokeAsync();
    }

    private sealed class ActionItemParams
    {
        public string Icon { get; set; } = string.Empty;
        public string Label { get; set; } = string.Empty;
        public EventCallback OnClick { get; set; }
        public bool Danger { get; set; }
    }
}
