@inject IShareService ShareService
@inject ISignalRService SignalR
@inject IAppStateService AppState
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L
@implements IAsyncDisposable

<div class="flex-1 flex flex-col min-h-0 relative">

@if (_selectionMode)
{
    <div class="absolute top-14 left-0 right-0 z-30 flex items-center gap-3 px-4 py-2.5
                bg-indigo-50/90 dark:bg-indigo-900/80 backdrop-blur-sm
                border-b border-indigo-100 dark:border-indigo-800">
        <button @onclick="CancelSelection"
                class="text-sm text-gray-500 dark:text-gray-400 active:opacity-70">@L["MessageList_Cancel"]</button>
        <span class="flex-1 text-sm text-gray-700 dark:text-gray-300 text-center">@string.Format(L["MessageList_Selected"], _selectedIds.Count)</span>
        <button @onclick="DeleteSelectedAsync"
                disabled="@(_selectedIds.Count == 0 || _deleting)"
                class="text-sm text-red-500 dark:text-red-400 font-medium disabled:opacity-40 active:opacity-70">
            @(_deleting ? L["Common_Deleting"] : L["Common_Delete"])
        </button>
    </div>
}

@if (_loading)
{
    <!-- 骨架屏：切换主题或首次加载时显示 -->
    <div class="flex-1 min-h-0 overflow-hidden px-4 py-4 space-y-4">
        <div class="h-12"></div>
        <div class="skeleton-shimmer h-10 w-2/3"></div>
        <div class="skeleton-shimmer h-10 w-1/2"></div>
        <div class="skeleton-shimmer h-14 w-4/5"></div>
        <div class="skeleton-shimmer h-10 w-2/5"></div>
        <div class="skeleton-shimmer h-10 w-3/5"></div>
        <div class="skeleton-shimmer h-14 w-1/2"></div>
        <div class="skeleton-shimmer h-10 w-3/4"></div>
    </div>
}
else
{
    <div id="message-list-container"
         class="flex-1 min-h-0 overflow-y-auto px-4 pt-16 pb-3 space-y-3 message-scroll touch-scroll message-list-fadein">
        <!-- 下拉加载更多指示器 -->
        @if (AppState.HasMoreMessages)
        {
            <div class="pull-to-load-indicator flex justify-center py-1 opacity-0 transition-opacity duration-150" aria-hidden="true">
                @if (_loadingMore)
                {
                    <div class="w-5 h-5 border-2 border-indigo-400/40 border-t-indigo-500 rounded-full animate-spin"></div>
                }
                else
                {
                    <div class="flex items-center gap-1.5 text-xs text-indigo-500 dark:text-indigo-400">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7" />
                        </svg>
                        @L["Common_LoadMore"]
                    </div>
                }
            </div>
        }

        @if (AppState.Messages.Count == 0)
        {
            <div class="flex items-center justify-center h-40 text-gray-400 dark:text-gray-500 text-sm">
                @L["MessageList_NoMessages"]
            </div>
        }
        <div class="@(_selectionMode ? "h-24" : "h-12")"></div>
        @if (AppState.Messages.Count <= 200)
        {
            @foreach (var msg in AppState.Messages)
            {
                <MessageItem Item="msg"
                             SelectionMode="_selectionMode"
                             IsSelected="_selectedIds.Contains(msg.Id)"
                             OnToggleSelect="ToggleSelect"
                             OnEnterSelectionMode="EnterSelectionMode"
                             OnDelete="DeleteSingleAsync" />
            }
        }
        else
        {
            <Virtualize Items="@(AppState.Messages as ICollection<ShareItemDto> ?? AppState.Messages.ToList())" Context="msg">
                <MessageItem Item="msg"
                             SelectionMode="_selectionMode"
                             IsSelected="_selectedIds.Contains(msg.Id)"
                             OnToggleSelect="ToggleSelect"
                             OnEnterSelectionMode="EnterSelectionMode"
                             OnDelete="DeleteSingleAsync" />
            </Virtualize>
        }
        <div class="h-24"></div>
    </div>
}

@if (!_loading && !_isNearBottom && AppState.Messages.Count > 0)
{
    <button @onclick="ScrollToLatestAsync"
            class="absolute bottom-32 right-4 z-20 px-3 py-2 rounded-full text-xs font-semibold text-white shadow-lg"
            style="background: linear-gradient(135deg, #4f46e5, #2563eb);">
            <span class="material-symbols-outlined" style="font-size: 16px;">south</span>
        @L["MessageList_BackToLatest"]
    </button>
}

</div>

@code {
    [Parameter] public Guid TopicId { get; set; }

    private bool _loading;
    private bool _loadingMore;
    private bool _selectionMode;
    private bool _deleting;
    private bool _isNearBottom = true;
    private bool _pendingScrollToBottom;
    private readonly HashSet<Guid> _selectedIds = [];
    private DotNetObjectReference<MessageList>? _dotNetRef;
    private bool _nearBottomObserverInitialized;
    private bool _pullToLoadInitialized;

    private Guid _lastTopicId;

    protected override async Task OnParametersSetAsync()
    {
        if (TopicId != _lastTopicId)
        {
            _lastTopicId = TopicId;
            _selectionMode = false;
            _selectedIds.Clear();
            _pullToLoadInitialized = false;
            await LoadMessagesAsync();
        }
    }

    protected override void OnInitialized()
    {
        SignalR.TopicsUpdated += OnTopicsUpdated;
        SignalR.ShareItemReceived += OnShareItemReceived;
        SignalR.ShareItemsDeleted += OnShareItemsDeleted;
        AppState.OnChange += StateHasChanged;
        AppState.MessageAdded += OnMessageAdded;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_pendingScrollToBottom)
        {
            _pendingScrollToBottom = false;
            await ScrollToBottomAsync();
        }

        if (!_loading && !_nearBottomObserverInitialized)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("scrollUtils.setupNearBottomObserver", "message-list-container", _dotNetRef, 120);
            _nearBottomObserverInitialized = true;
        }

        if (!_loading && !_pullToLoadInitialized && AppState.HasMoreMessages)
        {
            _dotNetRef ??= DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("scrollUtils.setupPullToLoad", "message-list-container", _dotNetRef, 60);
            _pullToLoadInitialized = true;
        }
    }

    private async Task LoadMessagesAsync()
    {
        _loading = true;
        StateHasChanged();
        try
        {
            var result = await ShareService.GetMessagesAsync(TopicId);
            AppState.Messages.Clear();
            // 服务端返回最新消息在前（降序），翻转后最新在底部
            for (int i = result.Messages.Count - 1; i >= 0; i--)
                AppState.Messages.Add(result.Messages[i]);
            AppState.HasMoreMessages = result.HasMore;
            AppState.MessageCursor = result.NextCursor;
            AppState.NotifyStateChanged();
            RequestScrollToBottom();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageList] 加载消息失败: {ex.Message}");
            await ShowConnectionFailedAsync();
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task LoadMoreAsync()
    {
        _loadingMore = true;
        try
        {
            var result = await ShareService.GetMessagesAsync(TopicId, before: AppState.MessageCursor);
            var existingIds = AppState.Messages.Select(m => m.Id).ToHashSet();
            var newItems = result.Messages.Where(m => !existingIds.Contains(m.Id)).ToList();
            // 服务端返回较旧消息（降序），翻转后按时间升序插入到列表头部
            newItems.Reverse(); // List<T>.Reverse() in-place，无额外分配
            for (int i = 0; i < newItems.Count; i++)
                AppState.Messages.Insert(i, newItems[i]);
            AppState.HasMoreMessages = result.HasMore;
            AppState.MessageCursor = result.NextCursor;
            AppState.NotifyStateChanged();
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException or InvalidOperationException)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageList] 加载更多消息失败: {ex.Message}");
            await ShowConnectionFailedAsync();
        }
        finally
        {
            _loadingMore = false;
        }
    }

    private void OnTopicsUpdated(IReadOnlyList<TopicDto> topics)
    {
        // Real-time messages arrive via ShareItemReceived; TopicsUpdated is kept subscribed
        // so the sidebar topic list (managed elsewhere) stays up to date.
    }

    private void OnShareItemReceived(ShareItemDto item)
    {
        if (item.TopicId != TopicId) return;
        InvokeAsync(async () =>
        {
            if (AppState.Messages.Any(m => m.Id == item.Id)) return;
            AppState.Messages.Add(item);
            AppState.NotifyStateChanged();
            if (_isNearBottom)
            {
                RequestScrollToBottom();
            }
        });
    }

    private void OnShareItemsDeleted(IReadOnlyList<Guid> ids)
    {
        InvokeAsync(() =>
        {
            var idSet = ids.ToHashSet();
            var removed = AppState.Messages.Where(m => idSet.Contains(m.Id)).ToList();
            if (removed.Count == 0) return;
            foreach (var m in removed) AppState.Messages.Remove(m);
            _selectedIds.ExceptWith(idSet);
            if (_selectedIds.Count == 0 && _selectionMode) _selectionMode = false;
            AppState.NotifyStateChanged();
        });
    }

    private void OnMessageAdded()
    {
        // AppState.OnChange 已经触发了 StateHasChanged，此处只需同步设置滚动标志。
        // OnAfterRenderAsync 在本次 render 完成后会检测该标志并执行滚动。
        if (_isNearBottom)
            _pendingScrollToBottom = true;
    }

    private void RequestScrollToBottom()
    {
        _pendingScrollToBottom = true;
    }

    private async Task ScrollToBottomAsync()
    {
        try
        {
            await JS.InvokeVoidAsync("scrollUtils.scrollToBottom", "message-list-container");
            _isNearBottom = await JS.InvokeAsync<bool>("scrollUtils.isNearBottom", "message-list-container", 120);
        }
        catch
        {
            _isNearBottom = true;
        }
    }

    [JSInvokable]
    public Task OnPullToLoad()
    {
        if (_loadingMore || !AppState.HasMoreMessages || _selectionMode) return Task.CompletedTask;
        return InvokeAsync(LoadMoreAsync);
    }

    [JSInvokable]
    public Task OnNearBottomChanged(bool isNearBottom)
    {
        if (_isNearBottom == isNearBottom)
        {
            return Task.CompletedTask;
        }

        _isNearBottom = isNearBottom;
        return InvokeAsync(StateHasChanged);
    }

    private async Task ScrollToLatestAsync()
    {
        await ScrollToBottomAsync();
    }

    private void EnterSelectionMode(Guid id)
    {
        _selectionMode = true;
        _selectedIds.Add(id);
        StateHasChanged();
    }

    /// <summary>从外部（如页面头部按钮）进入批量选择模式。</summary>
    public void EnterBatchSelectionMode()
    {
        _selectionMode = true;
        StateHasChanged();
    }

    private void ToggleSelect(Guid id)
    {
        if (_selectedIds.Contains(id))
            _selectedIds.Remove(id);
        else
            _selectedIds.Add(id);
        StateHasChanged();
    }

    private async Task DeleteSingleAsync(Guid id)
    {
        try
        {
            await ShareService.DeleteMessagesAsync([id]);
            var msg = AppState.Messages.FirstOrDefault(m => m.Id == id);
            if (msg is not null)
            {
                AppState.Messages.Remove(msg);
                AppState.NotifyStateChanged();
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageList] 删除消息失败: {ex.Message}");
        }
    }

    private void CancelSelection()
    {
        _selectionMode = false;
        _selectedIds.Clear();
        StateHasChanged();
    }

    private async Task DeleteSelectedAsync()
    {
        if (_selectedIds.Count == 0) return;
        _deleting = true;
        StateHasChanged();
        try
        {
            await ShareService.DeleteMessagesAsync([.. _selectedIds]);
            // 从本地列表移除已删除的消息
            var removed = AppState.Messages.Where(m => _selectedIds.Contains(m.Id)).ToList();
            foreach (var m in removed) AppState.Messages.Remove(m);
            _selectedIds.Clear();
            _selectionMode = false;
            AppState.NotifyStateChanged();
        }
        catch { /* ignore */ }
        finally
        {
            _deleting = false;
        }
    }

    public ValueTask DisposeAsync()
    {
        SignalR.TopicsUpdated -= OnTopicsUpdated;
        SignalR.ShareItemReceived -= OnShareItemReceived;
        SignalR.ShareItemsDeleted -= OnShareItemsDeleted;
        AppState.OnChange -= StateHasChanged;
        AppState.MessageAdded -= OnMessageAdded;
        var dotNetRef = _dotNetRef;
        _dotNetRef = null;
        _nearBottomObserverInitialized = false;
        _pullToLoadInitialized = false;
        return new ValueTask(CleanupObserversAsync(dotNetRef));
    }

    private async Task CleanupObserversAsync(DotNetObjectReference<MessageList>? dotNetRef)
    {
        try
        {
            await JS.InvokeVoidAsync("scrollUtils.cleanupNearBottomObserver", "message-list-container");
            await JS.InvokeVoidAsync("scrollUtils.cleanupPullToLoad", "message-list-container");
        }
        catch
        {
            // ignore cleanup failures during component dispose
        }
        finally
        {
            dotNetRef?.Dispose();
        }
    }

    private async Task ShowConnectionFailedAsync()
    {
#if ANDROID || IOS || MACCATALYST || WINDOWS
        if (Application.Current?.MainPage is not null)
        {
            await MainThread.InvokeOnMainThreadAsync(() =>
                Application.Current.MainPage.DisplayAlert(
                    L["ConnectionFailed_Title"],
                    L["ConnectionFailed_Message"],
                    L["ConnectionFailed_OK"]));
        }
#endif
        Nav.NavigateTo("/login");
    }
}
