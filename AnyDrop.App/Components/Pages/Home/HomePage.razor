@page "/"
@layout MainLayout
@inject ITopicService TopicService
@inject ISignalRService SignalR
@inject IAppStateService AppState
@inject NavigationManager Nav
@implements IDisposable

<div class="flex h-full overflow-hidden">
    @if (_showSidebar || _isWide)
    {
        <div class="@(_isWide ? "w-64" : "fixed inset-0 z-40 flex")">
            @if (!_isWide)
            {
                <div class="fixed inset-0 bg-black/50" @onclick="() => _showSidebar = false"></div>
            }
            <div class="@(_isWide ? "w-full" : "w-72 relative z-50 h-full bg-white dark:bg-gray-800 shadow-xl") overflow-y-auto touch-scroll">
                <TopicSidebar OnTopicSelected="OnTopicSelected" />
            </div>
        </div>
    }

    <div class="flex-1 flex flex-col overflow-hidden">
        <div class="flex items-center gap-3 px-4 py-3" style="background: linear-gradient(160deg, #2B6EF5 0%, #4C8BFF 100%);">
            @if (!_isWide)
            {
                <button @onclick="() => _showSidebar = true" class="w-9 h-9 rounded-full flex items-center justify-center text-white/80 active:bg-white/10 transition-colors">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5" />
                    </svg>
                </button>
            }
            <div class="flex-1 flex flex-col leading-tight">
                <span class="font-bold text-lg text-white leading-tight">
                    @(AppState.Topics.FirstOrDefault(t => t.Id == AppState.CurrentTopicId)?.Name ?? "选择主题")
                </span>
                <span class="text-xs text-white/60">存储会话</span>
            </div>
            @if (AppState.CurrentTopicId.HasValue)
            {
                <button @onclick="() => _messageList?.EnterBatchSelectionMode()"
                        aria-label="进入选择模式"
                        class="flex items-center gap-1 text-sm text-white/80 font-medium active:opacity-70 transition-opacity px-1 py-0.5">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M3 4.5h14.25M3 9h9.75M3 13.5h9.75m4.5-4.5v12m0 0l-3.75-3.75M17.25 21L21 17.25" />
                    </svg>
                    <span>选择</span>
                </button>
            }
            <button aria-label="搜索" class="w-9 h-9 rounded-full flex items-center justify-center text-white/80 active:bg-white/10 transition-colors"
                    @onclick='() => Nav.NavigateTo("/search")'>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                </svg>
            </button>
            <button aria-label="更多" class="w-9 h-9 rounded-full flex items-center justify-center text-white/80 active:bg-white/10 transition-colors">
                <!-- 预留：未来可扩展为主题设置等操作菜单 -->
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 12.75a.75.75 0 110-1.5.75.75 0 010 1.5zM12 18.75a.75.75 0 110-1.5.75.75 0 010 1.5z" />
                </svg>
            </button>
        </div>

        @if (AppState.CurrentTopicId.HasValue)
        {
            <MessageList @ref="_messageList" TopicId="AppState.CurrentTopicId.Value" />
            <MessageInput TopicId="AppState.CurrentTopicId.Value" />
        }
        else
        {
            <div class="flex-1 flex items-center justify-center">
                <div class="text-center px-6">
                    <div class="text-5xl mb-4 opacity-60">📁</div>
                    <p class="text-sm text-gray-400 dark:text-gray-500">请从左侧选择或创建一个主题</p>
                </div>
            </div>
        }
    </div>
</div>

@code {
    [SupplyParameterFromQuery] public string? TopicId { get; set; }

    private bool _showSidebar;
    private bool _isWide = false;
    private MessageList? _messageList;

    protected override async Task OnInitializedAsync()
    {
        AppState.OnChange += StateHasChanged;
        try { await LoadTopicsAsync(); } catch { /* BaseUrl 未配置或网络不可达时静默失败 */ }

        if (TopicId is not null && Guid.TryParse(TopicId, out var id))
            AppState.CurrentTopicId = id;

        if (SignalR.State == Microsoft.AspNetCore.SignalR.Client.HubConnectionState.Disconnected)
        {
            try { await SignalR.StartAsync(); } catch { /* ignore */ }
        }
    }

    private async Task LoadTopicsAsync()
    {
        var topics = await TopicService.GetTopicsAsync();
        AppState.Topics.Clear();
        foreach (var t in topics) AppState.Topics.Add(t);
        if (AppState.CurrentTopicId is null && AppState.Topics.Count > 0)
            AppState.CurrentTopicId = AppState.Topics[0].Id;
        AppState.NotifyStateChanged();
    }

    private void OnTopicSelected(Guid topicId)
    {
        AppState.CurrentTopicId = topicId;
        _showSidebar = false;
        AppState.NotifyStateChanged();
    }

    public void Dispose()
    {
        AppState.OnChange -= StateHasChanged;
    }
}
