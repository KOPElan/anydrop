@inject IServerConfigService ServerConfig
@inject ISecureTokenStorage TokenStorage
@inject IShareService ShareService
@inject NavigationManager Nav

<div class="flex items-start gap-2 @(_selectionMode ? "cursor-pointer" : "")"
     @onclick="HandleContainerClick">
    @if (_selectionMode)
    {
        <div class="flex-shrink-0 mt-1 w-5 h-5 rounded-full border-2 flex items-center justify-center transition-colors
                    @(IsSelected ? "bg-indigo-600 border-indigo-600" : "border-gray-300 dark:border-gray-600")">
            @if (IsSelected)
            {
                <svg xmlns="http://www.w3.org/2000/svg" class="h-3 w-3 text-white" viewBox="0 0 20 20" fill="currentColor">
                    <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                </svg>
            }
        </div>
    }

    <div class="@GetContainerClass() max-w-xs flex-1">
        @switch (Item.ContentType)
        {
            case ShareContentType.Text:
                <pre class="text-sm text-gray-800 dark:text-gray-100 whitespace-pre-wrap font-sans leading-relaxed">@Item.Content</pre>
                break;

            case ShareContentType.Image:
                <div class="cursor-pointer active:opacity-80 transition-opacity" @onclick:stopPropagation="true" @onclick="NavigateToImagePreview">
                    @if (!string.IsNullOrEmpty(_fileUrl))
                    {
                        <img src="@_fileUrl" alt="image"
                             class="rounded-xl max-w-full min-h-16 bg-gray-100 dark:bg-gray-700" />
                    }
                    else
                    {
                        <div class="rounded-xl h-24 w-40 bg-gray-100 dark:bg-gray-700 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
                            </svg>
                        </div>
                    }
                </div>
                break;

            case ShareContentType.Video:
                <div class="@(_selectionMode ? "" : "cursor-pointer")" @onclick:stopPropagation="true">
                    @if (!string.IsNullOrEmpty(_fileUrl))
                    {
                        <video src="@_fileUrl"
                               controls
                               playsinline
                               preload="metadata"
                               class="rounded-xl max-w-full max-h-56"
                               @onclick:stopPropagation="true">
                        </video>
                    }
                    else
                    {
                        <div class="bg-gray-100 dark:bg-gray-700 rounded-xl h-32 flex items-center justify-center">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-12 w-12 text-gray-400 dark:text-gray-500" viewBox="0 0 24 24" fill="currentColor">
                                <path d="M8 5v14l11-7z" />
                            </svg>
                        </div>
                    }
                    @if (Item.FileName is not null)
                    {
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1.5 truncate px-1">@Item.FileName</p>
                    }
                </div>
                break;

            case ShareContentType.File:
                <div class="flex items-center gap-3">
                    <div class="flex-shrink-0 w-10 h-10 bg-indigo-100 dark:bg-indigo-900/40 rounded-xl flex items-center justify-center">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-indigo-600 dark:text-indigo-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m2.25 0H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z" />
                        </svg>
                    </div>
                    <div class="flex-1 min-w-0">
                        <p class="text-sm font-medium truncate text-gray-800 dark:text-gray-100">@Item.FileName</p>
                        <p class="text-xs text-gray-400 dark:text-gray-500">@FormatSize(Item.FileSize)</p>
                    </div>
                    <button @onclick="SaveFileAsync" @onclick:stopPropagation="true"
                            disabled="@_saving"
                            class="w-8 h-8 rounded-full flex items-center justify-center text-indigo-600 dark:text-indigo-400 active:bg-indigo-50 dark:active:bg-indigo-900/20 transition-colors disabled:opacity-40">
                        @if (_saving)
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 animate-spin" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0l3.181 3.183a8.25 8.25 0 0013.803-3.7M4.031 9.865a8.25 8.25 0 0113.803-3.7l3.181 3.182m0-4.991v4.99" />
                            </svg>
                        }
                        else
                        {
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3" />
                            </svg>
                        }
                    </button>
                </div>
                break;

            case ShareContentType.Link:
                <div class="space-y-1.5 cursor-pointer active:opacity-70 transition-opacity" @onclick:stopPropagation="true" @onclick="OpenLinkAsync">
                    @if (Item.LinkTitle is not null)
                    {
                        <p class="text-sm font-semibold text-gray-800 dark:text-gray-100">@Item.LinkTitle</p>
                    }
                    @if (Item.LinkDescription is not null)
                    {
                        <p class="text-xs text-gray-500 dark:text-gray-400 line-clamp-2">@Item.LinkDescription</p>
                    }
                    <p class="text-xs text-indigo-600 dark:text-indigo-400 truncate">@Item.Content</p>
                </div>
                break;
        }
        <p class="text-xs text-gray-400 dark:text-gray-500 mt-2 text-right">@Item.CreatedAt.ToLocalTime().ToString("HH:mm")</p>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public ShareItemDto Item { get; set; } = null!;
    [Parameter] public bool SelectionMode { get; set; }
    [Parameter] public bool IsSelected { get; set; }
    [Parameter] public EventCallback<Guid> OnToggleSelect { get; set; }
    [Parameter] public EventCallback<Guid> OnEnterSelectionMode { get; set; }

    private string _fileUrl = string.Empty;
    private bool _saving;
    private bool _selectionMode => SelectionMode;

    protected override async Task OnParametersSetAsync()
    {
        if (Item.ContentType is ShareContentType.Image or ShareContentType.Video)
        {
            _fileUrl = await BuildFileUrlAsync(download: false);
            StateHasChanged();
        }
    }

    private void NavigateToImagePreview() => Nav.NavigateTo($"/image-preview/{Item.Id}");

    private string GetContainerClass()
    {
        if (Item.ExpiresAt.HasValue)
            return "bubble-burn";
        return Item.ContentType switch
        {
            ShareContentType.Link => "bubble-link",
            _ => "bubble-text"
        };
    }

    private async Task<string> BuildFileUrlAsync(bool download)
    {
        var baseUrl = ServerConfig.GetBaseUrl();
        if (string.IsNullOrWhiteSpace(baseUrl))
            return string.Empty;

        var token = await TokenStorage.GetTokenAsync().ConfigureAwait(false);
        var queryParts = new List<string>();

        if (download)
            queryParts.Add("download=true");

        if (!string.IsNullOrWhiteSpace(token))
            queryParts.Add($"access_token={Uri.EscapeDataString(token)}");

        var query = queryParts.Count > 0 ? "?" + string.Join("&", queryParts) : string.Empty;
        return $"{baseUrl}/api/v1/share-items/{Item.Id}/file{query}";
    }

    private async Task SaveFileAsync()
    {
        if (_saving) return;
        _saving = true;
        StateHasChanged();
        try
        {
            var stream = await ShareService.DownloadFileAsync(Item.Id);
            var fileName = Item.FileName ?? "download.bin";
#if ANDROID || IOS || MACCATALYST || WINDOWS
            var cacheDir = FileSystem.CacheDirectory;
            var filePath = Path.Combine(cacheDir, fileName);
            using (var fs = File.OpenWrite(filePath))
            {
                await stream.CopyToAsync(fs);
            }
            await Microsoft.Maui.ApplicationModel.DataTransfer.Share.RequestAsync(new ShareFileRequest
            {
                Title = fileName,
                File = new ShareFile(filePath)
            });
#else
            await Task.CompletedTask;
#endif
        }
        catch { /* ignore */ }
        finally
        {
            _saving = false;
            StateHasChanged();
        }
    }

    private async Task OpenLinkAsync()
    {
        if (string.IsNullOrWhiteSpace(Item.Content)) return;
#if ANDROID || IOS || MACCATALYST || WINDOWS
        await Browser.OpenAsync(Item.Content, BrowserLaunchMode.SystemPreferred);
#else
        await Task.CompletedTask;
#endif
    }

    private async Task HandleContainerClick()
    {
        if (_selectionMode)
            await OnToggleSelect.InvokeAsync(Item.Id);
    }

    private static string FormatSize(long? bytes) => bytes switch
    {
        null => "",
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        _ => $"{bytes / (1024.0 * 1024):F1} MB"
    };
}
