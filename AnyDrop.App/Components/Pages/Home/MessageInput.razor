@inject IShareService ShareService
@inject IFileUploadService FileUploadService
@inject IPickerService Picker
@inject IAppStateService AppState
@inject IOutboxService Outbox
@inject AppEventBus EventBus
@inject AnyDrop.App.Platform.IPreferenceStore Preferences
@inject IStringLocalizer<AppStrings> L
@implements IDisposable

<div class="glass border-t border-white/50 dark:border-gray-700/50 px-3 pt-2 pb-1 safe-area-bottom fixed bottom-0 w-full">
    @if (_outboxPendingCount > 0)
    {
        <button @onclick="DrainOutboxAsync" class="mb-2 px-1 text-left w-full">
            <p class="text-xs text-amber-600 dark:text-amber-400">@string.Format(L["MessageInput_OutboxPending"], _outboxPendingCount)</p>
        </button>
    }
    @if (_pickerPermissionDenied)
    {
        <div class="mb-2 px-1 flex items-center gap-2 rounded-xl bg-amber-50 dark:bg-amber-900/25 px-3 py-2">
            <p class="flex-1 text-xs text-amber-700 dark:text-amber-300">@L["MessageInput_PermissionDenied"]</p>
            <button @onclick="OpenAppSettingsAsync" class="text-xs font-medium text-indigo-600 dark:text-indigo-400 active:opacity-70">@L["MessageInput_OpenSettings"]</button>
            <button @onclick="() => _pickerPermissionDenied = false" class="text-xs text-gray-400 active:opacity-70">@L["Common_Close"]</button>
        </div>
    }
    @if (_uploadError is not null)
    {
        <div class="mb-2 px-1 flex items-center gap-2">
            <p class="flex-1 text-xs text-red-500 dark:text-red-400">@_uploadError</p>
            <button @onclick="() => _uploadError = null" class="text-xs text-gray-400 active:opacity-70">@L["Common_Close"]</button>
        </div>
    }
    @if (_uploading)
    {
        <div class="mb-2 px-1">
            <div class="h-1.5 bg-gray-100 dark:bg-gray-700 rounded-full overflow-hidden">
                <div class="upload-progress-bar" style="width: @((_uploadProgress * 100).ToString("F0"))%;"></div>
            </div>
            <p class="text-xs text-gray-400 dark:text-gray-500 mt-1">@L["MessageInput_Uploading"] @((_uploadProgress * 100).ToString("F0"))%</p>
        </div>
    }

    <!-- 第1行：文本框 + 发送按钮 -->
    <div class="flex items-end gap-2 mb-1">
        <textarea value="@_text" @oninput="OnTextInput" @onkeydown="OnKeyDown"
                  placeholder="@L["MessageInput_Placeholder"]"
                  rows="1"
                  class="flex-1 px-4 py-2.5 rounded-2xl border border-gray-200 dark:border-gray-700 bg-gray-50 dark:bg-gray-700/50 text-sm text-gray-900 dark:text-gray-100 placeholder-gray-400 dark:placeholder-gray-500 resize-none focus:outline-none focus:border-blue-400/50 focus:ring-2 focus:ring-blue-400/15 transition-all duration-150 max-h-32 overflow-y-auto"></textarea>

        <button @onclick="SendTextAsync"
                disabled="@(string.IsNullOrWhiteSpace(_text) || _uploading)"
                class="btn-send flex-shrink-0">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4.5 10.5L12 3m0 0l7.5 7.5M12 3v18" />
            </svg>
        </button>
    </div>

    <!-- 第2行：操作图标 -->
    <div class="flex items-center gap-1 px-1 pb-1">
        <button @onclick="PickPhotoAndUploadAsync" disabled="@_uploading"
                class="w-9 h-9 rounded-xl flex items-center justify-center text-gray-400 dark:text-gray-500 active:bg-gray-100 dark:active:bg-gray-700 disabled:opacity-40 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M2.25 15.75l5.159-5.159a2.25 2.25 0 013.182 0l5.159 5.159m-1.5-1.5l1.409-1.41a2.25 2.25 0 013.182 0l2.909 2.91m-18 3.75h16.5a1.5 1.5 0 001.5-1.5V6a1.5 1.5 0 00-1.5-1.5H3.75A1.5 1.5 0 002.25 6v12a1.5 1.5 0 001.5 1.5zm10.5-11.25h.008v.008h-.008V8.25zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z" />
            </svg>
        </button>
        <button @onclick="PickFileAndUploadAsync" disabled="@_uploading"
                class="w-9 h-9 rounded-xl flex items-center justify-center text-gray-400 dark:text-gray-500 active:bg-gray-100 dark:active:bg-gray-700 disabled:opacity-40 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M18.375 12.739l-7.693 7.693a4.5 4.5 0 01-6.364-6.364l10.94-10.94A3 3 0 1119.5 7.372L8.552 18.32m.009-.01l-.01.01m5.699-9.941l-7.81 7.81a1.5 1.5 0 002.112 2.13" />
            </svg>
        </button>
        <button @onclick="ToggleBurnAfterReading"
                disabled="@_uploading"
                title="@L["MessageInput_BurnAfterReading"]"
                class="w-9 h-9 rounded-xl flex items-center justify-center disabled:opacity-40 transition-colors @(_burnAfterReading ? "text-amber-600 dark:text-amber-400 bg-amber-50 dark:bg-amber-900/25" : "text-gray-400 dark:text-gray-500 active:bg-gray-100 dark:active:bg-gray-700")">
            <span class="material-symbols-outlined text-[18px]" style="font-variation-settings: 'FILL' @( _burnAfterReading ? 1 : 0 );">local_fire_department</span>
        </button>
    </div>
</div>

@code {
    [Parameter] public Guid TopicId { get; set; }

    private string _text = string.Empty;
    private bool _uploading;
    private double _uploadProgress;
    private string? _uploadError;
    private bool _burnAfterReading;
    // 每次用户修改 _text 都递增，用于判断发送期间是否有新的用户输入
    private int _textGeneration;
    // S2-05：发件箱待发送条数（>0 时显示提示，点击立即重试补发）
    private int _outboxPendingCount;
    private bool _drainingOutbox;
    // S2-08：选择器权限被拒时显示去设置的提示条
    private bool _pickerPermissionDenied;

    protected override void OnInitialized()
    {
        EventBus.ConnectivityChanged += OnConnectivityChanged;
        _ = RefreshOutboxCountAsync();
        RestoreDraft();
    }

    protected override void OnParametersSet()
    {
        // 切换话题时恢复该话题的草稿（每个话题独立保存）
        RestoreDraft();
    }

    /// <summary>S2-05：输入框草稿落盘——按话题保存，杀进程/切话题后回来仍在。</summary>
    private string DraftKey => $"anydrop_draft_{TopicId}";

    private void RestoreDraft()
    {
        try
        {
            _text = Preferences.Get(DraftKey, string.Empty) ?? string.Empty;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 恢复草稿失败: {ex.Message}");
        }
    }

    private void SaveDraft()
    {
        try
        {
            Preferences.Set(DraftKey, _text);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 保存草稿失败: {ex.Message}");
        }
    }

    private void ClearDraft()
    {
        try
        {
            Preferences.Set(DraftKey, string.Empty);
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 清除草稿失败: {ex.Message}");
        }
    }

    private void OnConnectivityChanged(bool isOnline)
    {
        // 网络恢复时自动补发发件箱
        if (isOnline)
        {
            _ = InvokeAsync(DrainOutboxAsync);
        }
    }

    /// <summary>S2-05：按入箱顺序补发离线消息；成功发出的消息加入当前话题列表（若在看该话题）。</summary>
    private async Task DrainOutboxAsync()
    {
        if (_drainingOutbox)
        {
            return;
        }

        _drainingOutbox = true;
        try
        {
            await Outbox.DrainAsync(async m =>
            {
                var item = await ShareService.SendTextAsync(
                    new CreateTextShareItemRequest(m.Content, m.TopicId, m.BurnAfterReading));
                if (m.TopicId == TopicId && !AppState.Messages.Any(x => x.Id == item.Id))
                {
                    AppState.Messages.Add(item);
                    AppState.NotifyMessageAdded();
                }
            });
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 发件箱补发失败: {ex.Message}");
        }
        finally
        {
            _drainingOutbox = false;
            await RefreshOutboxCountAsync();
        }
    }

    private async Task RefreshOutboxCountAsync()
    {
        try
        {
            var pending = await Outbox.GetPendingAsync();
            var count = pending.Count;
            if (count != _outboxPendingCount)
            {
                _outboxPendingCount = count;
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 读取发件箱失败: {ex.Message}");
        }
    }

    public void Dispose()
    {
        EventBus.ConnectivityChanged -= OnConnectivityChanged;
    }

    private async Task SendTextAsync()
    {
        if (string.IsNullOrWhiteSpace(_text)) return;
        var textToSend = _text;
        var sendGeneration = _textGeneration;
        _text = string.Empty;
        // 发送即清草稿（无论成功还是入箱），避免中途重渲染把旧草稿恢复回来
        ClearDraft();
        try
        {
            var item = await ShareService.SendTextAsync(new CreateTextShareItemRequest(textToSend, TopicId, _burnAfterReading));
            // 防止竞态：SignalR 推送可能在 HTTP 响应返回前已将该条消息加入列表
            if (!AppState.Messages.Any(m => m.Id == item.Id))
                AppState.Messages.Add(item);
            AppState.NotifyMessageAdded();
        }
        catch (Exception ex) when (ex is HttpRequestException { StatusCode: null } or TaskCanceledException)
        {
            // S2-05：无 HTTP 状态码 = 网络不可达/超时（非服务端拒绝），写入离线发件箱持久化，
            // 联网后自动补发；输入框不恢复（消息已入箱），避免用户重复发送。
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 离线，消息已存入发件箱: {ex.Message}");
            try
            {
                await Outbox.EnqueueAsync(TopicId, textToSend, _burnAfterReading);
            }
            catch (Exception enqueueEx)
            {
                System.Diagnostics.Debug.WriteLine($"[MessageInput] 发件箱写入失败，恢复输入: {enqueueEx.Message}");
                if (_textGeneration == sendGeneration)
                {
                    _text = textToSend;
                    SaveDraft();
                }
            }

            await RefreshOutboxCountAsync();
        }
        catch (Exception ex)
        {
            // 服务端拒绝（如 400/401/413）不入箱：恢复输入内容，仅在用户自发送后未修改过输入框时才恢复
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 发送消息失败: {ex.Message}");
            if (_textGeneration == sendGeneration)
            {
                _text = textToSend;
                SaveDraft();
            }
        }
    }

    private async Task PickFileAndUploadAsync()
    {
        var result = await Picker.PickFilesAsync();
        if (result.Status == PickStatus.PermissionDenied)
        {
            _pickerPermissionDenied = true;
            return;
        }
        if (result.Status != PickStatus.Ok) return;
        await UploadManyAsync(result.Files);
    }

    private async Task PickPhotoAndUploadAsync()
    {
        var result = await Picker.PickPhotosAsync();
        if (result.Status == PickStatus.PermissionDenied)
        {
            _pickerPermissionDenied = true;
            return;
        }
        if (result.Status != PickStatus.Ok) return;
        await UploadManyAsync(result.Files);
    }

    /// <summary>S2-08：多选文件依次上传，总进度 = (已完成数 + 当前文件进度) / 总数。</summary>
    private async Task UploadManyAsync(IReadOnlyList<PickedFile> files)
    {
        _uploading = true;
        _uploadProgress = 0;
        _uploadError = null;
        try
        {
            for (var i = 0; i < files.Count; i++)
            {
                var index = i;
                var progress = new Progress<double>(p =>
                {
                    _uploadProgress = (index + p) / files.Count;
                    InvokeAsync(StateHasChanged);
                });
                await UploadAsync(files[i].Stream, files[i].FileName, files[i].MimeType, progress);
            }
        }
        catch (UploadFailedException ex)
        {
            // S3-06：服务端拒绝上传时按错误码显示本地化文案；码未知时显示服务端原文。
            _uploadError = ApiErrorMessages.Localize(ex.ErrorCode, TryLocalize, ex.Message);
        }
        catch (Exception ex)
        {
            _uploadError = ex.Message;
        }
        finally
        {
            _uploading = false;
            _uploadProgress = 0;
        }
    }

    /// <summary>S3-06：resx 查词辅助——键不存在时返回 null（供 ApiErrorMessages.Localize 回退）。</summary>
    private string? TryLocalize(string key)
    {
        var localized = L[key];
        return localized.ResourceNotFound ? null : localized.Value;
    }

    /// <summary>打开系统设置（应用权限页），让用户为被拒的权限重新授权。</summary>
    private void OpenAppSettingsAsync()
    {
        _pickerPermissionDenied = false;
        try
        {
            AppInfo.ShowSettingsUI();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[MessageInput] 打开系统设置失败: {ex.Message}");
        }
    }

    private async Task UploadAsync(Stream stream, string fileName, string mimeType, IProgress<double> progress)
    {
        var item = await FileUploadService.UploadFileAsync(stream, fileName, mimeType, TopicId, _burnAfterReading, progress);
        // 防止竞态：SignalR 推送可能已先于 HTTP 响应将文件消息加入列表
        if (!AppState.Messages.Any(m => m.Id == item.Id))
            AppState.Messages.Add(item);
        AppState.NotifyMessageAdded();
    }

    private void OnTextInput(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? string.Empty;
        _textGeneration++;
        SaveDraft();
    }

    private async Task OnKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !e.ShiftKey)
            await SendTextAsync();
    }

    private void ToggleBurnAfterReading()
    {
        _burnAfterReading = !_burnAfterReading;
    }
}
