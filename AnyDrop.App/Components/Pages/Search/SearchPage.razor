@page "/search"
@layout MainLayout
@inject ISearchService SearchService
@inject IAppStateService AppState
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L
@implements IDisposable

<div class="flex flex-col h-full overflow-hidden">
    <!-- 标题栏 -->
    <div class="flex items-center gap-2 px-4 py-3 header-blue-glass flex-shrink-0">
        <button @onclick='() => Nav.NavigateTo("/")'
                aria-label="@L["Common_Back"]"
                class="w-9 h-9 rounded-full flex items-center justify-center text-gray-600 dark:text-white/80 active:bg-black/5 dark:active:bg-white/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
        </button>
        <span class="flex-1 font-bold text-lg text-gray-800 dark:text-white">@L["Search_Title"]</span>
    </div>

    <div class="bg-white/80 dark:bg-gray-800/80 glass border-b border-gray-100 dark:border-gray-800 px-4 pt-3 pb-3 space-y-3 flex-shrink-0">
        <div class="segmented-control">
            @foreach (var mode in Modes)
            {
                <button @onclick="() => SetModeAsync(mode.Key)"
                        class="segmented-btn @(_mode == mode.Key ? "segmented-btn-active" : "segmented-btn-inactive")">
                    @mode.Value
                </button>
            }
        </div>
    </div>

    <div class="flex-1 overflow-y-auto touch-scroll">
        @if (_mode == "keyword")
        {
            <div class="px-4 pt-3 pb-2">
                <div class="relative">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 absolute left-3.5 top-1/2 -translate-y-1/2 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-5.197-5.197m0 0A7.5 7.5 0 105.196 5.196a7.5 7.5 0 0010.607 10.607z" />
                    </svg>
                    <input value="@_keyword" @oninput="OnKeywordInput"
                           type="search" placeholder="@L["Search_InputPlaceholder"]"
                           class="input-base pl-9" />
                </div>
            </div>
            @if (_loading)
            {
                <div class="flex justify-center py-8">
                    <div class="w-5 h-5 border-2 border-indigo-400/30 border-t-indigo-500 rounded-full animate-spin"></div>
                </div>
            }
            else if (_results.Count == 0 && !string.IsNullOrWhiteSpace(_keyword))
            {
                <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">@L["Search_NoResults"]</div>
            }
            @foreach (var item in _results)
            {
                <SearchResultItem Item="item" />
            }
            @if (_hasMore)
            {
                <div class="text-center py-4">
                    @if (_loading)
                    {
                        <div class="flex justify-center py-2">
                            <div class="w-4 h-4 border-2 border-indigo-400/30 border-t-indigo-500 rounded-full animate-spin"></div>
                        </div>
                    }
                    else
                    {
                        <button @onclick="LoadMoreAsync"
                                class="text-xs text-indigo-600 dark:text-indigo-400 font-medium active:opacity-70">@L["Common_LoadMore"]</button>
                    }
                </div>
            }
        }
        else if (_mode == "date")
        {
            @if (AppState.CurrentTopicId.HasValue)
            {
                <ActiveDateCalendar TopicId="AppState.CurrentTopicId.Value"
                                    SelectedDate="_selectedDate"
                                    OnDateSelected="OnDateSelectedAsync" />
                @if (_loading)
                {
                    <div class="space-y-1 px-4">
                        <div class="skeleton-shimmer h-16 w-full rounded-xl"></div>
                        <div class="skeleton-shimmer h-16 w-full rounded-xl"></div>
                        <div class="skeleton-shimmer h-12 w-full rounded-xl"></div>
                    </div>
                }
                else
                {
                    @foreach (var item in _results)
                    {
                        <SearchResultItem Item="item" />
                    }
                    @if (_results.Count == 0 && _selectedDate.HasValue)
                    {
                        <div class="text-center py-12 text-gray-400 dark:text-gray-500 text-sm">@L["Search_NoMessagesOnDate"]</div>
                    }
                }
            }
            else
            {
                <div class="text-center py-16 text-gray-400 dark:text-gray-500 text-sm">@L["Search_NoTopicSelected"]</div>
            }
        }
        else
        {
            <div class="flex gap-1.5 px-4 py-3 flex-wrap">
                @foreach (var type in ContentTypes)
                {
                    <button @onclick="() => SetContentTypeAsync(type.Key)"
                            class="px-3.5 py-1.5 rounded-full text-xs font-medium transition-all duration-150 active:scale-95 @(_contentType == type.Key ? "bg-indigo-600 text-white shadow-sm" : "bg-gray-100 dark:bg-gray-700 text-gray-600 dark:text-gray-300")">
                        @type.Value
                    </button>
                }
            </div>
            @if (_loading)
            {
                <div class="space-y-1 px-4">
                    <div class="skeleton-shimmer h-16 w-full rounded-xl"></div>
                    <div class="skeleton-shimmer h-16 w-full rounded-xl"></div>
                    <div class="skeleton-shimmer h-12 w-full rounded-xl"></div>
                </div>
            }
            else
            {
                @foreach (var item in _results)
                {
                    <SearchResultItem Item="item" />
                }
                @if (_results.Count == 0)
                {
                    <div class="text-center py-12 text-gray-400 dark:text-gray-500 text-sm">@L["Search_NoContentType"]</div>
                }
            }
            @if (_hasMore)
            {
                <div class="text-center py-4">
                    @if (_loading)
                    {
                        <div class="flex justify-center py-2">
                            <div class="w-4 h-4 border-2 border-indigo-400/30 border-t-indigo-500 rounded-full animate-spin"></div>
                        </div>
                    }
                    else
                    {
                        <button @onclick="LoadMoreAsync"
                                class="text-xs text-indigo-600 dark:text-indigo-400 font-medium active:opacity-70">@L["Common_LoadMore"]</button>
                    }
                </div>
            }
        }
    </div>
</div>

@code {
    private string _mode = "keyword";
    private string _keyword = string.Empty;
    private ShareContentType _contentType = ShareContentType.Text;
    private DateOnly? _selectedDate;
    private List<ShareItemDto> _results = [];
    private bool _loading;
    private bool _hasMore;
    private string? _cursor;
    private System.Threading.Timer? _debounceTimer;

    private const int PageSize = 20;

    // 使用计算属性而非静态字典，以便每次渲染时读取最新的本地化字符串
    private Dictionary<string, string> Modes => new()
    {
        ["keyword"] = L["Search_Keyword"],
        ["date"] = L["Search_Date"],
        ["type"] = L["Search_Type"],
    };

    private Dictionary<ShareContentType, string> ContentTypes => new()
    {
        [ShareContentType.Text] = L["Search_Text"],
        [ShareContentType.Image] = L["Search_Image"],
        [ShareContentType.Video] = L["Search_Video"],
        [ShareContentType.File] = L["Search_File"],
        [ShareContentType.Link] = L["Search_Link"],
    };

    private async Task SetModeAsync(string mode)
    {
        _mode = mode;
        _results.Clear();
        _cursor = null;
        _hasMore = false;

        // 切换到"类型"时自动加载默认类型；切换到"日期"时自动加载今天
        if (mode == "type")
        {
            await SetContentTypeAsync(_contentType);
            return;
        }
        if (mode == "date" && AppState.CurrentTopicId.HasValue)
        {
            _selectedDate = DateOnly.FromDateTime(DateTime.Today);
            await LoadByDateAsync(_selectedDate.Value);
            return;
        }
        StateHasChanged();
    }

    private void OnKeywordInput(ChangeEventArgs e)
    {
        _keyword = e.Value?.ToString() ?? string.Empty;
        _debounceTimer?.Dispose();
        _debounceTimer = new System.Threading.Timer(async _ =>
        {
            await InvokeAsync(async () =>
            {
                _results.Clear();
                _cursor = null;
                if (!string.IsNullOrWhiteSpace(_keyword) && AppState.CurrentTopicId.HasValue)
                {
                    _loading = true;
                    StateHasChanged();
                    var items = await SearchService.SearchAsync(AppState.CurrentTopicId.Value, _keyword, limit: PageSize);
                    _results.AddRange(items);
                    _cursor = items.Count > 0 ? items[^1].CreatedAt.ToString("O") : null;
                    _hasMore = items.Count >= PageSize;
                    _loading = false;
                }
                StateHasChanged();
            });
        }, null, 300, System.Threading.Timeout.Infinite);
    }

    private async Task OnDateSelectedAsync(DateOnly date)
    {
        _selectedDate = date;
        await LoadByDateAsync(date);
    }

    private async Task LoadByDateAsync(DateOnly date)
    {
        if (!AppState.CurrentTopicId.HasValue) return;
        _results.Clear();
        _loading = true;
        StateHasChanged();
        try
        {
            var items = await SearchService.GetByDateAsync(AppState.CurrentTopicId.Value, date);
            _results.AddRange(items);
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task SetContentTypeAsync(ShareContentType type)
    {
        _contentType = type;
        _results.Clear();
        _cursor = null;
        _hasMore = false;
        if (!AppState.CurrentTopicId.HasValue) return;
        _loading = true;
        StateHasChanged();
        try
        {
            var items = await SearchService.GetByTypeAsync(AppState.CurrentTopicId.Value, type, limit: PageSize);
            _results.AddRange(items);
            _cursor = items.Count > 0 ? items[^1].CreatedAt.ToString("O") : null;
            _hasMore = items.Count >= PageSize;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    private async Task LoadMoreAsync()
    {
        if (!AppState.CurrentTopicId.HasValue) return;
        _loading = true;
        StateHasChanged();
        try
        {
            IReadOnlyList<ShareItemDto> items;
            if (_mode == "keyword")
                items = await SearchService.SearchAsync(AppState.CurrentTopicId.Value, _keyword, limit: PageSize, before: _cursor);
            else
                items = await SearchService.GetByTypeAsync(AppState.CurrentTopicId.Value, _contentType, limit: PageSize, before: _cursor);
            _results.AddRange(items);
            _cursor = items.Count > 0 ? items[^1].CreatedAt.ToString("O") : _cursor;
            _hasMore = items.Count >= PageSize;
        }
        finally
        {
            _loading = false;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _debounceTimer?.Dispose();
    }
}
