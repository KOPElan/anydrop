@inject ISearchService SearchService

<div class="p-4 space-y-3">
    <p class="text-xs font-medium text-gray-500 dark:text-gray-400 uppercase tracking-wider">按日期筛选</p>
    <div class="flex flex-wrap gap-2">
        @foreach (var day in _recentDays)
        {
            var date = day;
            var isActive = _activeDates.Contains(date);
            var isSelected = date == _selectedDate;
            <button @onclick="() => SelectDate(date)"
                    class="px-3 py-1.5 rounded-full text-sm font-medium transition-colors
                           @(isSelected ? "bg-indigo-600 text-white" :
                             isActive ? "bg-indigo-100 dark:bg-indigo-900/40 text-indigo-700 dark:text-indigo-300" :
                             "bg-gray-100 dark:bg-gray-700 text-gray-500 dark:text-gray-400")">
                @FormatDay(date)
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public Guid TopicId { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }

    private HashSet<DateOnly> _activeDates = [];
    private List<DateOnly> _recentDays = [];
    private DateOnly? _selectedDate;

    protected override async Task OnParametersSetAsync()
    {
        BuildRecentDays();
        await LoadActiveDatesAsync();
    }

    private void BuildRecentDays()
    {
        _recentDays.Clear();
        var today = DateOnly.FromDateTime(DateTime.Today);
        for (int i = 0; i < 7; i++)
            _recentDays.Add(today.AddDays(-i));
    }

    private async Task LoadActiveDatesAsync()
    {
        if (_recentDays.Count == 0) return;
        var today = DateOnly.FromDateTime(DateTime.Today);
        // 加载最近两个月的有效日期（覆盖7天范围）
        var dates = await SearchService.GetActiveDatesAsync(TopicId, today.Year, today.Month);
        _activeDates = [.. dates];
        if (today.Month != _recentDays.Last().Month)
        {
            var prevMonth = today.AddMonths(-1);
            var prevDates = await SearchService.GetActiveDatesAsync(TopicId, prevMonth.Year, prevMonth.Month);
            foreach (var d in prevDates) _activeDates.Add(d);
        }
    }

    private async Task SelectDate(DateOnly date)
    {
        _selectedDate = date;
        await OnDateSelected.InvokeAsync(date);
    }

    private static string FormatDay(DateOnly date)
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        return date == today ? "今天" :
               date == today.AddDays(-1) ? "昨天" :
               $"{date.Month}/{date.Day}";
    }
}
