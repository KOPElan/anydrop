@inject ISearchService SearchService

@* 日期导航栏 *@
<div class="flex items-center gap-2 px-4 py-3">
    <button @onclick="PrevDayAsync"
            class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 dark:text-gray-400 active:bg-gray-100 dark:active:bg-gray-700 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
        </svg>
    </button>

    <button @onclick="ToggleCalendar"
            class="flex-1 text-center py-2 rounded-xl text-sm font-medium text-gray-800 dark:text-gray-100
                   bg-gray-100 dark:bg-gray-700/60 active:bg-gray-200 dark:active:bg-gray-700 transition-colors">
        @FormatSelectedDate()
    </button>

    <button @onclick="NextDayAsync"
            disabled="@(!CanGoNext)"
            class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 dark:text-gray-400 active:bg-gray-100 dark:active:bg-gray-700 disabled:opacity-30 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
        </svg>
    </button>
</div>

@* 日历展开面板 *@
@if (_showCalendar)
{
    <div class="mx-4 mb-3 rounded-2xl border border-gray-100 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-md overflow-hidden">
        @* 月份导航 *@
        <div class="flex items-center justify-between px-4 py-3 border-b border-gray-100 dark:border-gray-700">
            <button @onclick="PrevMonthAsync"
                    class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 dark:text-gray-400 active:bg-gray-100 dark:active:bg-gray-700 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7" />
                </svg>
            </button>
            <span class="text-sm font-semibold text-gray-800 dark:text-gray-100">
                @_calYear 年 @_calMonth 月
            </span>
            <button @onclick="NextMonthAsync"
                    disabled="@(!CanGoNextMonth)"
                    class="w-8 h-8 rounded-full flex items-center justify-center text-gray-500 dark:text-gray-400 active:bg-gray-100 dark:active:bg-gray-700 disabled:opacity-30 transition-colors">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                </svg>
            </button>
        </div>

        @* 星期表头 *@
        <div class="grid grid-cols-7 px-3 pt-2 pb-1">
            @foreach (var h in new[] { "日", "一", "二", "三", "四", "五", "六" })
            {
                <div class="text-center text-xs text-gray-400 dark:text-gray-500 py-1">@h</div>
            }
        </div>

        @* 日期格子 *@
        <div class="grid grid-cols-7 px-3 pb-3 gap-y-0.5">
            @foreach (var day in _calendarDays)
            {
                @if (day is null)
                {
                    <div></div>
                }
                else
                {
                    var d = day.Value;
                    var isSelected = d == SelectedDate;
                    var hasMsg = _activeDates.Contains(d);
                    var isToday = d == _today;
                    var isFuture = d > _today;
                    <button @onclick="() => SelectDateAsync(d)"
                            disabled="@isFuture"
                            class="relative flex flex-col items-center justify-center py-1.5 rounded-xl text-sm transition-colors disabled:opacity-30
                                   @(isSelected
                                       ? "bg-indigo-600 text-white font-semibold"
                                       : isToday
                                           ? "bg-indigo-50 dark:bg-indigo-900/30 text-indigo-600 dark:text-indigo-400 font-medium"
                                           : "text-gray-700 dark:text-gray-300 active:bg-gray-100 dark:active:bg-gray-700")">
                        <span>@d.Day</span>
                        @if (hasMsg)
                        {
                            <span class="w-1 h-1 rounded-full mt-0.5 @(isSelected ? "bg-white/70" : "bg-indigo-500 dark:bg-indigo-400")"></span>
                        }
                    </button>
                }
            }
        </div>

        @* 月份加载中 *@
        @if (_loadingDates)
        {
            <div class="flex justify-center py-2">
                <div class="w-4 h-4 border-2 border-indigo-400/30 border-t-indigo-500 rounded-full animate-spin"></div>
            </div>
        }
    </div>
}

@code {
    [Parameter] public Guid TopicId { get; set; }
    [Parameter] public DateOnly? SelectedDate { get; set; }
    [Parameter] public EventCallback<DateOnly> OnDateSelected { get; set; }

    private bool _showCalendar;
    private bool _loadingDates;
    private int _calYear;
    private int _calMonth;
    private Guid _lastTopicId;
    private HashSet<DateOnly> _activeDates = [];
    private List<DateOnly?> _calendarDays = [];
    private DateOnly _today = DateOnly.FromDateTime(DateTime.Today);

    private bool CanGoNext => SelectedDate is null || SelectedDate.Value < _today;
    private bool CanGoNextMonth => new DateOnly(_calYear, _calMonth, 1) < new DateOnly(_today.Year, _today.Month, 1);

    protected override async Task OnParametersSetAsync()
    {
        _today = DateOnly.FromDateTime(DateTime.Today);
        // 仅在首次渲染或主题切换时重新初始化日历
        if (_calYear == 0 || TopicId != _lastTopicId)
        {
            _lastTopicId = TopicId;
            _calYear = _today.Year;
            _calMonth = _today.Month;
            BuildCalendar();
            await LoadActiveDatesAsync();
        }
    }

    private void BuildCalendar()
    {
        _calendarDays.Clear();
        var firstDay = new DateOnly(_calYear, _calMonth, 1);
        int startDayOfWeek = (int)firstDay.DayOfWeek; // 0=Sunday
        for (int i = 0; i < startDayOfWeek; i++)
            _calendarDays.Add(null);
        int daysInMonth = DateTime.DaysInMonth(_calYear, _calMonth);
        for (int d = 1; d <= daysInMonth; d++)
            _calendarDays.Add(new DateOnly(_calYear, _calMonth, d));
    }

    private async Task LoadActiveDatesAsync()
    {
        _loadingDates = true;
        StateHasChanged();
        try
        {
            var dates = await SearchService.GetActiveDatesAsync(TopicId, _calYear, _calMonth);
            _activeDates = [.. dates];
        }
        finally
        {
            _loadingDates = false;
            StateHasChanged();
        }
    }

    private void ToggleCalendar()
    {
        _showCalendar = !_showCalendar;
    }

    private async Task SelectDateAsync(DateOnly date)
    {
        _showCalendar = false;
        await OnDateSelected.InvokeAsync(date);
    }

    private async Task PrevDayAsync()
    {
        var current = SelectedDate ?? _today;
        await OnDateSelected.InvokeAsync(current.AddDays(-1));
    }

    private async Task NextDayAsync()
    {
        var current = SelectedDate ?? _today;
        var next = current.AddDays(1);
        if (next <= _today)
            await OnDateSelected.InvokeAsync(next);
    }

    private async Task PrevMonthAsync()
    {
        if (_calMonth == 1)
        {
            _calYear--;
            _calMonth = 12;
        }
        else
        {
            _calMonth--;
        }
        BuildCalendar();
        await LoadActiveDatesAsync();
    }

    private async Task NextMonthAsync()
    {
        var nextFirstDay = new DateOnly(_calYear, _calMonth, 1).AddMonths(1);
        if (nextFirstDay <= new DateOnly(_today.Year, _today.Month, 1))
        {
            _calYear = nextFirstDay.Year;
            _calMonth = nextFirstDay.Month;
            BuildCalendar();
            await LoadActiveDatesAsync();
        }
    }

    private string FormatSelectedDate()
    {
        if (SelectedDate is null) return "选择日期";
        if (SelectedDate == _today) return $"{SelectedDate.Value:yyyy/MM/dd}（今天）";
        if (SelectedDate == _today.AddDays(-1)) return $"{SelectedDate.Value:yyyy/MM/dd}（昨天）";
        return SelectedDate.Value.ToString("yyyy/MM/dd");
    }
}
