@page "/share"
@layout AuthLayout
@inject IShareService ShareService
@inject IFileUploadService FileUploadService
@inject ITopicService TopicService
@inject IConnectivityService Connectivity
@inject NavigationManager Nav

<div class="flex flex-col h-full bg-white dark:bg-gray-900">
    <div class="flex items-center gap-3 px-4 py-3 border-b border-gray-100 dark:border-gray-800">
        <button @onclick="GoBack" class="w-9 h-9 rounded-full flex items-center justify-center text-gray-500 dark:text-gray-400 active:bg-gray-100 dark:active:bg-gray-800 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
        </button>
        <h1 class="font-semibold text-sm text-gray-800 dark:text-gray-100">分享至 AnyDrop</h1>
    </div>

    <div class="flex-1 overflow-y-auto p-4 space-y-4 touch-scroll">
        @if (!Connectivity.IsOnline)
        {
            <div class="bg-amber-50 dark:bg-amber-900/20 border border-amber-200 dark:border-amber-800/50 rounded-2xl p-3 text-sm text-amber-700 dark:text-amber-300">
                📡 无网络连接，内容已暂存。
                <button @onclick="SendAsync" class="underline font-medium ml-1">重试</button>
            </div>
        }

        @if (_content is not null)
        {
            <div class="bg-gray-50 dark:bg-gray-800/50 rounded-2xl p-4">
                @if (_content.Text is not null)
                {
                    <pre class="text-sm text-gray-700 dark:text-gray-300 whitespace-pre-wrap font-sans leading-relaxed">@_content.Text</pre>
                }
                @foreach (var path in _content.FilePaths)
                {
                    <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400 mt-2">
                        <span>📎</span>
                        <span class="truncate">@System.IO.Path.GetFileName(path)</span>
                    </div>
                }
            </div>
        }

        <div>
            <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1.5">选择目标主题</label>
            <select @bind="_selectedTopicId" class="input-base appearance-none">
                <option value="">-- 请选择主题 --</option>
                @foreach (var topic in _topics)
                {
                    <option value="@topic.Id">@topic.Name</option>
                }
            </select>
        </div>

        @if (_error is not null)
        {
            <p class="text-red-500 text-sm text-center">@_error</p>
        }
    </div>

    <div class="px-4 py-3 border-t border-gray-100 dark:border-gray-800 safe-area-bottom">
        <button @onclick="SendAsync"
                disabled="@(_sending || string.IsNullOrEmpty(_selectedTopicId))"
                class="btn-primary">
            @(_sending ? "发送中..." : "发送")
        </button>
    </div>
</div>

@code {
    private SharedContent? _content;
    private List<TopicDto> _topics = [];
    private string _selectedTopicId = string.Empty;
    private bool _sending;
    private string? _error;

    protected override async Task OnInitializedAsync()
    {
        _content = PendingShareStore.Content;
        _topics = (await TopicService.GetTopicsAsync()).ToList();
        if (_topics.Count > 0) _selectedTopicId = _topics[0].Id.ToString();
    }

    private void GoBack() => Nav.NavigateTo("/");

    private async Task SendAsync()
    {
        if (!Guid.TryParse(_selectedTopicId, out var topicId)) return;
        _sending = true;
        _error = null;

        try
        {
            if (_content?.Text is not null)
                await ShareService.SendTextAsync(new CreateTextShareItemRequest(_content.Text!, topicId));

            foreach (var path in _content?.FilePaths ?? [])
            {
                using var stream = File.OpenRead(path);
                var fileName = System.IO.Path.GetFileName(path);
                var mime = _content?.MimeType ?? "application/octet-stream";
                await FileUploadService.UploadFileAsync(stream, fileName, mime, topicId);
            }

            PendingShareStore.Clear();
            Nav.NavigateTo("/");
        }
        catch (Exception ex)
        {
            _error = $"发送失败：{ex.Message}";
            _sending = false;
        }
    }
}
