@page "/setup-account"
@layout AuthLayout
@inject IAuthService AuthService
@inject ISignalRService SignalR
@inject INotificationService Notifications
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L

<div class="space-y-5">
    <div class="text-center">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100">@L["SetupAccount_Title"]</h2>
        <p class="text-sm text-gray-400 dark:text-gray-500 mt-1">@L["SetupAccount_Subtitle"]</p>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1.5">@L["Common_Nickname"]</label>
        <input @bind="_nickname" type="text" placeholder="@L["SetupAccount_NicknamePlaceholder"]" class="input-base" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1.5">@L["Common_Password"]</label>
        <input @bind="_password" type="password" placeholder="@L["SetupAccount_PasswordPlaceholder"]" class="input-base" />
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1.5">@L["Common_ConfirmPassword"]</label>
        <input @bind="_confirmPassword" type="password" placeholder="@L["SetupAccount_ConfirmPasswordPlaceholder"]" class="input-base" />
    </div>

    @if (_error is not null)
    {
        <p class="text-red-500 text-sm text-center">@_error</p>
    }

    <button @onclick="SetupAsync"
            disabled="@(_loading)"
            class="btn-primary">
        @(_loading ? L["SetupAccount_Creating"] : L["SetupAccount_Submit"])
    </button>
</div>

@code {
    private string _nickname = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string? _error;
    private bool _loading;

    private async Task SetupAsync()
    {
        if (string.IsNullOrWhiteSpace(_nickname)) { _error = L["SetupAccount_NicknameRequired"]; return; }
        if (string.IsNullOrWhiteSpace(_password)) { _error = L["SetupAccount_PasswordRequired"]; return; }
        if (_password != _confirmPassword) { _error = L["SetupAccount_PasswordMismatch"]; return; }

        _loading = true;
        _error = null;

        var result = await AuthService.SetupAsync(new SetupRequest(_nickname, _password, _confirmPassword));
        if (result.Success)
        {
            await Notifications.RequestPermissionAsync();
            await SignalR.StartAsync();
            Nav.NavigateTo("/");
        }
        else
        {
            _error = result.Error ?? L["SetupAccount_Failed"];
            _loading = false;
        }
    }
}
