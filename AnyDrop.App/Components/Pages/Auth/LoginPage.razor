@page "/login"
@layout AuthLayout
@inject IAuthService AuthService
@inject ISignalRService SignalR
@inject INotificationService Notifications
@inject NavigationManager Nav
@inject IStringLocalizer<AppStrings> L

<div class="space-y-5">
    <div class="flex items-center justify-between">
        <h2 class="text-xl font-semibold text-gray-800 dark:text-gray-100">@L["Login_Title"]</h2>
        <button @onclick='() => Nav.NavigateTo("/setup")'
                class="w-9 h-9 rounded-full flex items-center justify-center text-gray-400 dark:text-gray-500 active:bg-gray-100 dark:active:bg-gray-700 transition-colors"
                title="@L["Login_ConfigServer"]">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.324.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 011.37.49l1.296 2.247a1.125 1.125 0 01-.26 1.431l-1.003.827c-.293.24-.438.613-.431.992a6.759 6.759 0 010 .255c-.007.378.138.75.43.99l1.005.828c.424.35.534.954.26 1.43l-1.298 2.247a1.125 1.125 0 01-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.57 6.57 0 01-.22.128c-.331.183-.581.495-.644.869l-.213 1.28c-.09.543-.56.941-1.11.941h-2.594c-.55 0-1.02-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 01-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 01-1.369-.49l-1.297-2.247a1.125 1.125 0 01.26-1.431l1.004-.827c.292-.24.437-.613.43-.992a6.932 6.932 0 010-.255c.007-.378-.138-.75-.43-.99l-1.004-.828a1.125 1.125 0 01-.26-1.43l1.297-2.247a1.125 1.125 0 011.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.087.22-.128.332-.183.582-.495.644-.869l.214-1.281z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
        </button>
    </div>

    <div>
        <label class="block text-sm font-medium text-gray-600 dark:text-gray-400 mb-1.5">@L["Login_PasswordLabel"]</label>
        <input @bind="_password"
               @bind:event="oninput"
               type="password"
               placeholder="@L["Login_PasswordPlaceholder"]"
               class="input-base" />
    </div>

    @if (_error is not null)
    {
        <p class="text-red-500 text-sm text-center">@_error</p>
    }

    <button @onclick="LoginAsync"
            disabled="@(_loading || string.IsNullOrWhiteSpace(_password))"
            class="btn-primary">
        @(_loading ? L["Login_Submitting"] : L["Login_Submit"])
    </button>
</div>

@code {
    [SupplyParameterFromQuery] public string? ReturnTo { get; set; }

    private string _password = string.Empty;
    private string? _error;
    private bool _loading;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var status = await AuthService.GetSetupStatusAsync();
            if (status.RequiresSetup)
                Nav.NavigateTo("/setup-account");
        }
        catch { /* BaseUrl 暂不可用时静默忽略，保持在登录页让用户手动操作 */ }
    }

    private async Task LoginAsync()
    {
        if (string.IsNullOrWhiteSpace(_password)) return;
        _loading = true;
        _error = null;

        var result = await AuthService.LoginAsync(new LoginRequest(_password));
        if (result.Success)
        {
            await Notifications.RequestPermissionAsync();
            try
            {
                await SignalR.StartAsync();
            }
            catch (Exception ex)
            {
                // SignalR 连接失败不影响登录跳转，后续通过 MainLayout 的重连机制恢复
                System.Diagnostics.Debug.WriteLine($"[SignalR] 首次连接失败: {ex.Message}");
            }
            Nav.NavigateTo(ReturnTo ?? "/");
        }
        else
        {
            _error = result.Error ?? L["Login_InvalidCredentials"];
            _loading = false;
        }
    }
}
