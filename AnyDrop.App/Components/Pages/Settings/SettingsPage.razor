@page "/settings"
@layout MainLayout
@inject IAuthService AuthService
@inject ISettingsService SettingsService
@inject IServerConfigService ServerConfig
@inject ISignalRService SignalR
@inject ISecureTokenStorage TokenStorage
@inject NavigationManager Nav
@inject IJSRuntime JS

<div class="flex flex-col h-full overflow-hidden">
    <!-- 标题栏 -->
    <div class="flex items-center gap-2 px-4 py-3 header-blue-glass flex-shrink-0">
        <button @onclick='() => Nav.NavigateTo("/")'
                aria-label="返回"
                class="w-9 h-9 rounded-full flex items-center justify-center text-gray-600 dark:text-white/80 active:bg-black/5 dark:active:bg-white/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
        </button>
        <span class="flex-1 font-bold text-lg text-gray-800 dark:text-white">设置</span>
    </div>

    <div class="flex-1 overflow-y-auto touch-scroll">
        <div class="px-4 py-6 space-y-5 max-w-lg mx-auto">
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-4 shadow-sm">
            <h2 class="font-medium text-gray-400 dark:text-gray-500 text-xs uppercase tracking-wider">个人资料</h2>
            <div class="flex items-center gap-3">
                @if (_editNickname)
                {
                    <input @bind="_nicknameInput" type="text" class="input-base flex-1" />
                    <button @onclick="SaveNicknameAsync" class="text-indigo-600 text-sm font-medium active:opacity-70">保存</button>
                    <button @onclick="() => _editNickname = false" class="text-gray-400 text-sm">取消</button>
                }
                else
                {
                    <span class="flex-1 text-gray-800 dark:text-gray-100">@_nickname</span>
                    <button @onclick="() => { _editNickname = true; _nicknameInput = _nickname; }"
                            class="text-indigo-600 text-sm font-medium active:opacity-70">编辑</button>
                }
            </div>

            <div class="border-t border-gray-100 dark:border-gray-700/50 pt-4 space-y-3">
                <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">修改密码</h3>
                <input @bind="_currentPassword" type="password" placeholder="当前密码" class="input-base" />
                <input @bind="_newPassword" type="password" placeholder="新密码" class="input-base" />
                @if (_passwordError is not null)
                {
                    <p class="text-red-500 text-xs">@_passwordError</p>
                }
                <button @onclick="ChangePasswordAsync" class="btn-primary text-sm">修改密码</button>
            </div>
        </section>

        <!-- 外观与语言 -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-4 shadow-sm">
            <h2 class="font-medium text-gray-400 dark:text-gray-500 text-xs uppercase tracking-wider">外观与语言</h2>
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-800 dark:text-gray-100">深色模式</span>
                <button @onclick="ToggleThemeAsync"
                        class="w-11 h-6 rounded-full transition-colors relative @(_isDark ? "bg-indigo-600" : "bg-gray-300 dark:bg-gray-600")">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform @(_isDark ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>
        </section>

        <!-- 危险区域 -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-3 shadow-sm">
            <h2 class="font-medium text-red-500 dark:text-red-400 text-xs uppercase tracking-wider">危险区域</h2>
            <div class="space-y-2">
                <label class="block text-sm text-gray-500 dark:text-gray-400">修改服务端地址</label>
                <input @bind="_newBaseUrl" type="url" placeholder="@(ServerConfig.GetBaseUrl() ?? "")" class="input-base" />
                <button @onclick="ChangeServerUrlAsync" class="btn-danger">更换服务端地址</button>
            </div>
            <button @onclick="LogoutAsync" class="btn-danger mt-2">退出登录</button>
        </section>
    </div>
</div>
</div>

@code {
    private string _nickname = string.Empty;
    private bool _editNickname;
    private string _nicknameInput = string.Empty;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _passwordError;
    private bool _isDark;
    private string _newBaseUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var profile = await AuthService.GetCurrentUserAsync();
        _nickname = profile.Nickname;

        try
        {
#if ANDROID || IOS || MACCATALYST || WINDOWS
            // 从 Preferences 读取以确保 MAUI 端状态一致
            var savedTheme = Preferences.Get("anydrop_theme", "light");
            _isDark = string.Equals(savedTheme, "dark", StringComparison.OrdinalIgnoreCase);
            // 同步 JS 端 CSS 类，确保 WebView 也应用正确主题
            await JS.InvokeVoidAsync("ThemeManager.setTheme", _isDark ? "dark" : "light");
#else
            var savedTheme = await JS.InvokeAsync<string?>("ThemeManager.getTheme");
            _isDark = string.Equals(savedTheme, "dark", StringComparison.OrdinalIgnoreCase);
#endif
        }
        catch
        {
            _isDark = false;
        }
    }

    private async Task SaveNicknameAsync()
    {
        if (string.IsNullOrWhiteSpace(_nicknameInput)) return;
        await SettingsService.UpdateNicknameAsync(new UpdateNicknameRequest(_nicknameInput));
        _nickname = _nicknameInput;
        _editNickname = false;
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword)) return;
        try
        {
            await SettingsService.UpdatePasswordAsync(new UpdatePasswordRequest(_currentPassword, _newPassword, _newPassword));
            _currentPassword = _newPassword = string.Empty;
            _passwordError = null;
        }
        catch (HttpRequestException ex)
        {
            _passwordError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest ? "当前密码错误" : "修改失败，请重试";
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        var mode = _isDark ? "dark" : "light";
#if ANDROID || IOS || MACCATALYST || WINDOWS
        Preferences.Set("anydrop_theme", mode);
#endif
        await JS.InvokeVoidAsync("ThemeManager.setTheme", mode);
    }

    private async Task ChangeServerUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBaseUrl)) return;
        await SignalR.StopAsync();
        await TokenStorage.ClearTokenAsync();
        await ServerConfig.SetBaseUrlAsync(_newBaseUrl);
        Nav.NavigateTo("/setup");
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
