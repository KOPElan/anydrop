@page "/settings"
@layout MainLayout
@inject IAuthService AuthService
@inject ISettingsService SettingsService
@inject IServerConfigService ServerConfig
@inject ISignalRService SignalR
@inject INotificationService Notifications
@inject ISecureTokenStorage TokenStorage
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ILocalizationService Localization
@inject IStringLocalizer<AppStrings> L

<div class="flex flex-col h-full overflow-hidden">
    <!-- 标题栏 -->
    <div class="flex items-center gap-2 px-4 py-3 header-blue-glass flex-shrink-0">
        <button @onclick='() => Nav.NavigateTo("/")'
                aria-label="@L["Common_Back"]"
                class="w-9 h-9 rounded-full flex items-center justify-center text-gray-600 dark:text-white/80 active:bg-black/5 dark:active:bg-white/10 transition-colors">
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5L3 12m0 0l7.5-7.5M3 12h18" />
            </svg>
        </button>
        <span class="flex-1 font-bold text-lg text-gray-800 dark:text-white">@L["Settings_Title"]</span>
    </div>

    <div class="flex-1 overflow-y-auto touch-scroll">
        <div class="px-4 py-6 space-y-5 max-w-lg mx-auto">
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-4 shadow-sm">
            <h2 class="font-medium text-gray-400 dark:text-gray-500 text-xs uppercase tracking-wider">@L["Settings_Profile"]</h2>
            <div class="flex items-center gap-3">
                @if (_editNickname)
                {
                    <input @bind="_nicknameInput" type="text" class="input-base flex-1" />
                    <button @onclick="SaveNicknameAsync" class="text-indigo-600 text-sm font-medium active:opacity-70">@L["Common_Save"]</button>
                    <button @onclick="() => _editNickname = false" class="text-gray-400 text-sm">@L["Common_Cancel"]</button>
                }
                else
                {
                    <span class="flex-1 text-gray-800 dark:text-gray-100">@_nickname</span>
                    <button @onclick="() => { _editNickname = true; _nicknameInput = _nickname; }"
                            class="text-indigo-600 text-sm font-medium active:opacity-70">@L["Common_Edit"]</button>
                }
            </div>

            <div class="border-t border-gray-100 dark:border-gray-700/50 pt-4 space-y-3">
                <h3 class="text-sm font-medium text-gray-500 dark:text-gray-400">@L["Settings_ChangePassword"]</h3>
                <input @bind="_currentPassword" type="password" placeholder="@L["Settings_CurrentPassword"]" class="input-base" />
                <input @bind="_newPassword" type="password" placeholder="@L["Settings_NewPassword"]" class="input-base" />
                @if (_passwordError is not null)
                {
                    <p class="text-red-500 text-xs">@_passwordError</p>
                }
                <button @onclick="ChangePasswordAsync" class="btn-primary text-sm">@L["Settings_UpdatePassword"]</button>
            </div>
        </section>

        <!-- 外观与语言 -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-4 shadow-sm">
            <h2 class="font-medium text-gray-400 dark:text-gray-500 text-xs uppercase tracking-wider">@L["Settings_Appearance"]</h2>
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-800 dark:text-gray-100">@L["Settings_DarkMode"]</span>
                <button @onclick="ToggleThemeAsync"
                        class="w-11 h-6 rounded-full transition-colors relative @(_isDark ? "bg-indigo-600" : "bg-gray-300 dark:bg-gray-600")">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform @(_isDark ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>
            <!-- 语言选择 -->
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-800 dark:text-gray-100">@L["Settings_Language"]</span>
                <select value="@Localization.CurrentLanguage"
                        @onchange="OnLanguageChangedAsync"
                        class="text-sm bg-gray-100 dark:bg-gray-700 text-gray-800 dark:text-gray-100 rounded-lg px-2.5 py-1.5 border-none outline-none cursor-pointer">
                    @foreach (var lang in Localization.SupportedLanguages)
                    {
                        <option value="@lang.Code">@lang.NativeName</option>
                    }
                </select>
            </div>
        </section>

        <!-- S2-08：系统设置（与 Web 设置页同款字段，接 ISettingsService 真实接口） -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-4 shadow-sm">
            <h2 class="font-medium text-gray-400 dark:text-gray-500 text-xs uppercase tracking-wider">@L["Settings_Security"]</h2>
            <div class="flex items-center justify-between">
                <span class="text-sm text-gray-800 dark:text-gray-100">@L["Settings_AutoFetchLink"]</span>
                <button @onclick="() => _autoFetchLinkPreview = !_autoFetchLinkPreview"
                        aria-pressed="@_autoFetchLinkPreview"
                        class="w-11 h-6 rounded-full transition-colors relative @(_autoFetchLinkPreview ? "bg-indigo-600" : "bg-gray-300 dark:bg-gray-600")">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform @(_autoFetchLinkPreview ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>
            <div>
                <label class="block text-sm text-gray-800 dark:text-gray-100 mb-1">@L["Settings_BurnDuration"]</label>
                <p class="text-xs text-gray-400 dark:text-gray-500 mb-2">@L["Settings_BurnDurationHint"]</p>
                <input type="number" min="1" max="43200" @bind="_burnAfterReadingMinutes" class="input-base" />
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <span class="block text-sm text-gray-800 dark:text-gray-100">@L["Settings_Notifications"]</span>
                    <span class="block text-xs text-gray-400 dark:text-gray-500">@L["Settings_NotificationPermission"]: @(_notificationGranted is null ? "—" : _notificationGranted.Value ? L["Settings_NotificationGranted"] : L["Settings_NotificationNotGranted"])</span>
                </div>
                <button @onclick="RequestNotificationPermissionAsync" class="text-indigo-600 text-sm font-medium active:opacity-70">@L["Settings_RequestNotification"]</button>
            </div>
            @if (_securityMessage is not null)
            {
                <p class="text-xs @(_securitySaved ? "text-green-600" : "text-red-500")">@_securityMessage</p>
            }
            <button @onclick="SaveSecurityAsync" class="btn-primary text-sm">@L["Settings_SaveSecurity"]</button>
        </section>

        <!-- S2-08：消息管理（手动清理 + 自动清理，与 Web 设置页同款） -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-4 shadow-sm">
            <h2 class="font-medium text-gray-400 dark:text-gray-500 text-xs uppercase tracking-wider">@L["Settings_MessageManagement"]</h2>
            <div>
                <p class="text-sm font-medium text-gray-800 dark:text-gray-100">@L["Settings_ManualCleanup"]</p>
                <p class="mb-3 text-xs text-gray-400 dark:text-gray-500">@L["Settings_ManualCleanupHint"]</p>
                <div class="flex flex-wrap gap-2">
                    <button type="button" class="btn-secondary text-sm" disabled="@_isCleaningUp" @onclick="() => RequestCleanup(1)">@L["Settings_Cleanup1Month"]</button>
                    <button type="button" class="btn-secondary text-sm" disabled="@_isCleaningUp" @onclick="() => RequestCleanup(3)">@L["Settings_Cleanup3Months"]</button>
                    <button type="button" class="btn-secondary text-sm" disabled="@_isCleaningUp" @onclick="() => RequestCleanup(6)">@L["Settings_Cleanup6Months"]</button>
                </div>
                @if (_showCleanupConfirm)
                {
                    <div class="mt-3 rounded-xl bg-red-50 dark:bg-red-900/20 p-3 space-y-2">
                        <p class="text-sm font-medium text-red-600 dark:text-red-400">@L["Settings_CleanupConfirmTitle"]</p>
                        <p class="text-xs text-gray-600 dark:text-gray-300">@string.Format(L["Settings_CleanupConfirmMessage"], _pendingCleanupMonths)</p>
                        <div class="flex gap-2">
                            <button @onclick="ConfirmCleanupAsync" class="btn-danger text-sm">@L["Settings_CleanupConfirmAction"]</button>
                            <button @onclick="() => _showCleanupConfirm = false" class="btn-secondary text-sm">@L["Common_Cancel"]</button>
                        </div>
                    </div>
                }
                @if (_cleanupMessage is not null)
                {
                    <p class="mt-2 text-xs text-gray-500 dark:text-gray-400">@_cleanupMessage</p>
                }
            </div>
            <div class="flex items-center justify-between">
                <div>
                    <span class="block text-sm text-gray-800 dark:text-gray-100">@L["Settings_AutoCleanup"]</span>
                    <span class="block text-xs text-gray-400 dark:text-gray-500">@L["Settings_AutoCleanupHint"]</span>
                </div>
                <button @onclick="() => _autoCleanupEnabled = !_autoCleanupEnabled"
                        aria-pressed="@_autoCleanupEnabled"
                        class="w-11 h-6 rounded-full transition-colors relative @(_autoCleanupEnabled ? "bg-indigo-600" : "bg-gray-300 dark:bg-gray-600")">
                    <span class="absolute top-0.5 left-0.5 w-5 h-5 bg-white rounded-full shadow transition-transform @(_autoCleanupEnabled ? "translate-x-5" : "translate-x-0")"></span>
                </button>
            </div>
            @if (_autoCleanupEnabled)
            {
                <div>
                    <label class="block text-sm text-gray-800 dark:text-gray-100 mb-1">@L["Settings_AutoCleanupMonths"]</label>
                    <select value="@_autoCleanupMonths" @onchange="OnAutoCleanupMonthsChanged" class="input-base">
                        <option value="1">@L["Settings_AutoCleanupMonths1"]</option>
                        <option value="3">@L["Settings_AutoCleanupMonths3"]</option>
                        <option value="6">@L["Settings_AutoCleanupMonths6"]</option>
                    </select>
                </div>
            }
            <button @onclick="SaveSecurityAsync" class="btn-primary text-sm">@L["Settings_SaveSecurity"]</button>
        </section>

        <!-- 危险区域 -->
        <section class="bg-white dark:bg-gray-800 rounded-2xl p-4 space-y-3 shadow-sm">
            <h2 class="font-medium text-red-500 dark:text-red-400 text-xs uppercase tracking-wider">@L["Settings_DangerZone"]</h2>
            <div class="space-y-2">
                <label class="block text-sm text-gray-500 dark:text-gray-400">@L["Settings_ChangeServerUrl"]</label>
                <input @bind="_newBaseUrl" type="url" placeholder="@(ServerConfig.GetBaseUrl() ?? "")" class="input-base" />
                <button @onclick="ChangeServerUrlAsync" class="btn-danger">@L["Settings_UpdateServerUrl"]</button>
            </div>
            <button @onclick="LogoutAsync" class="btn-danger mt-2">@L["Settings_Logout"]</button>
        </section>
    </div>
</div>
</div>

@code {
    private string _nickname = string.Empty;
    private bool _editNickname;
    private string _nicknameInput = string.Empty;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private string? _passwordError;
    private bool _isDark;
    private string _newBaseUrl = string.Empty;
    // S2-08：安全设置（与 Web 设置页同款字段）
    private bool _autoFetchLinkPreview = true;
    private int _burnAfterReadingMinutes = 10;
    private bool _autoCleanupEnabled;
    private int _autoCleanupMonths = 1;
    // 缩略图定时任务字段本页不展示，加载后原样带回保存，避免误重置
    private int _thumbnailGenerationHour = 2;
    private bool _scheduledThumbnailGenerationEnabled;
    private string? _securityMessage;
    private bool _securitySaved;
    private bool? _notificationGranted;
    private bool _isCleaningUp;
    private int _pendingCleanupMonths;
    private bool _showCleanupConfirm;
    private string? _cleanupMessage;

    protected override async Task OnInitializedAsync()
    {
        var profile = await AuthService.GetCurrentUserAsync();
        _nickname = profile.Nickname;

        await LoadSecurityAsync();

        try
        {
#if ANDROID || IOS || MACCATALYST || WINDOWS
            // 从 Preferences 读取以确保 MAUI 端状态一致
            var savedTheme = Preferences.Get("anydrop_theme", "light");
            _isDark = string.Equals(savedTheme, "dark", StringComparison.OrdinalIgnoreCase);
            // 同步 JS 端 CSS 类，确保 WebView 也应用正确主题
            await JS.InvokeVoidAsync("ThemeManager.setTheme", _isDark ? "dark" : "light");
#else
            var savedTheme = await JS.InvokeAsync<string?>("ThemeManager.getTheme");
            _isDark = string.Equals(savedTheme, "dark", StringComparison.OrdinalIgnoreCase);
#endif
        }
        catch
        {
            _isDark = false;
        }
    }

    /// <summary>S2-08：加载安全设置；服务端要求定时销毁时长 1–43200，离线兜底值 0 在此纠为默认 10。</summary>
    private async Task LoadSecurityAsync()
    {
        try
        {
            var security = await SettingsService.GetSecuritySettingsAsync();
            _autoFetchLinkPreview = security.AutoFetchLinkPreview;
            _burnAfterReadingMinutes = security.BurnAfterReadingMinutes is >= 1 and <= 43200
                ? security.BurnAfterReadingMinutes
                : 10;
            _autoCleanupEnabled = security.AutoCleanupEnabled;
            _autoCleanupMonths = security.AutoCleanupMonths is 1 or 3 or 6 ? security.AutoCleanupMonths : 1;
            _thumbnailGenerationHour = security.ThumbnailGenerationHour;
            _scheduledThumbnailGenerationEnabled = security.ScheduledThumbnailGenerationEnabled;
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[SettingsPage] 加载安全设置失败: {ex.Message}");
        }
    }

    /// <summary>S2-08：保存安全设置（含自动清理）；语言取当前界面语言，缩略图字段原样带回。</summary>
    private async Task SaveSecurityAsync()
    {
        _securityMessage = null;
        try
        {
            var minutes = Math.Clamp(_burnAfterReadingMinutes, 1, 43200);
            _burnAfterReadingMinutes = minutes;
            await SettingsService.UpdateSecuritySettingsAsync(new UpdateSecuritySettingsRequest(
                _autoFetchLinkPreview,
                minutes,
                Localization.CurrentLanguage,
                _autoCleanupEnabled,
                _autoCleanupMonths,
                _thumbnailGenerationHour,
                _scheduledThumbnailGenerationEnabled));
            _securitySaved = true;
            _securityMessage = L["Settings_SecuritySaved"];
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[SettingsPage] 保存安全设置失败: {ex.Message}");
            _securitySaved = false;
            _securityMessage = L["Settings_SaveSecurityFailed"];
        }
    }

    private void OnAutoCleanupMonthsChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out var months) && months is 1 or 3 or 6)
        {
            _autoCleanupMonths = months;
        }
    }

    /// <summary>S2-08：手动清理需二次确认（内联确认条），确认后调真实清理接口。</summary>
    private void RequestCleanup(int months)
    {
        _pendingCleanupMonths = months;
        _showCleanupConfirm = true;
        _cleanupMessage = null;
    }

    private async Task ConfirmCleanupAsync()
    {
        _isCleaningUp = true;
        _showCleanupConfirm = false;
        _cleanupMessage = null;
        try
        {
            var deleted = await SettingsService.CleanupOldMessagesAsync(_pendingCleanupMonths);
            _cleanupMessage = deleted > 0
                ? string.Format(L["Settings_CleanupSuccess"], deleted)
                : L["Settings_CleanupNone"];
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[SettingsPage] 手动清理失败: {ex.Message}");
            _cleanupMessage = L["Settings_CleanupFailed"];
        }
        finally
        {
            _isCleaningUp = false;
        }
    }

    /// <summary>S2-08：请求通知权限（Android 13+ 弹系统对话框），显示当前授权状态。</summary>
    private async Task RequestNotificationPermissionAsync()
    {
        try
        {
            _notificationGranted = await Notifications.RequestPermissionAsync();
        }
        catch (Exception ex)
        {
            System.Diagnostics.Debug.WriteLine($"[SettingsPage] 请求通知权限失败: {ex.Message}");
            _notificationGranted = false;
        }
    }

    private async Task SaveNicknameAsync()
    {
        if (string.IsNullOrWhiteSpace(_nicknameInput)) return;
        await SettingsService.UpdateNicknameAsync(new UpdateNicknameRequest(_nicknameInput));
        _nickname = _nicknameInput;
        _editNickname = false;
    }

    private async Task ChangePasswordAsync()
    {
        if (string.IsNullOrWhiteSpace(_currentPassword) || string.IsNullOrWhiteSpace(_newPassword)) return;
        try
        {
            await SettingsService.UpdatePasswordAsync(new UpdatePasswordRequest(_currentPassword, _newPassword, _newPassword));
            _currentPassword = _newPassword = string.Empty;
            _passwordError = null;
        }
        catch (HttpRequestException ex)
        {
            _passwordError = ex.StatusCode == System.Net.HttpStatusCode.BadRequest
                ? L["Settings_WrongPassword"]
                : L["Settings_PasswordChangeFailed"];
        }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        var mode = _isDark ? "dark" : "light";
#if ANDROID || IOS || MACCATALYST || WINDOWS
        Preferences.Set("anydrop_theme", mode);
#endif
        await JS.InvokeVoidAsync("ThemeManager.setTheme", mode);
    }

    private Task OnLanguageChangedAsync(ChangeEventArgs e)
    {
        var code = e.Value?.ToString();
        if (!string.IsNullOrEmpty(code))
        {
            Localization.SetLanguage(code);
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        }
        return Task.CompletedTask;
    }

    private async Task ChangeServerUrlAsync()
    {
        if (string.IsNullOrWhiteSpace(_newBaseUrl)) return;
        await SignalR.StopAsync();
        await TokenStorage.ClearTokenAsync();
        await ServerConfig.SetBaseUrlAsync(_newBaseUrl);
        // S2-05：HubConnectionManager 会缓存旧地址建好的连接，必须重建，
        // 否则下次登录仍连旧服务器；SignalRService 重建后下次 StartAsync
        // 会在新连接上重新注册事件 handler。
        await SignalR.RebuildAsync();
        Nav.NavigateTo("/setup");
    }

    private async Task LogoutAsync()
    {
        await AuthService.LogoutAsync();
        Nav.NavigateTo("/login");
    }
}
