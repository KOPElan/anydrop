# Visual Studio / Rider / VS Code
.vs/
.vscode/
.idea/
.claude/
.specify/

# Build outputs
bin/
obj/
build/
publish/
artifacts/

# Ignore AnyDrop obj build outputs explicitly
/AnyDrop/obj/
/AnyDrop/.vs/

# AnyDrop/Data 目录同时存放源码（AnyDropDbContext.cs、DatabaseMigrationExtensions.cs 等）
# 与运行时数据（上传文件、Data Protection 密钥）。
#
# 这里只忽略运行时产物，不再整目录忽略：默认存储路径是相对项目目录的
# Storage:DatabasePath=data/anydrop.db，在大小写不敏感的文件系统（Windows）上
# 与源码目录 Data/ 是同一个目录，旧的 /AnyDrop/Data/ 规则会把以后新增的源码文件
# 静默排除在版本库之外，造成「代码写好了却没提交、CI 神秘失败」。
# 数据库文件本身已由下方的 *.db / *.db-shm / *.db-wal 规则覆盖。
/AnyDrop/[Dd]ata/files/
/AnyDrop/[Dd]ata/keys/
/AnyDrop/[Dd]ata/dpkeys/

# Rider
*.sln.iml

# User-specific files
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet
*.nupkg
packages/

# Logs
*.log

# OS files
.DS_Store
Thumbs.db

# Secrets and env
.env
.env.*
# 示例文件必须提交，否则 README 中的 `cp .env.example .env` 无法执行
!.env.example
secrets.json
secrets.*
*.Local.json

# Database files (do not commit runtime DB)
/data/
*.db
*.db-shm
*.db-wal
*.sqlite

# Node / frontend
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tailwind / build outputs
wwwroot/dist/
public/build/
/dist/
AnyDrop.App/wwwroot/css/tailwind.css

# Playwright
/playwright-report/

# Docker overrides for local development
docker-compose.override.yml
docker-compose.local.yml

# Misc
*.pid
*.seed
*.tmp
*.swp

# Ignore compiled test result files
TestResults/

# Ignore Visual Studio Code workspace settings
*.code-workspace
