# AnyDrop 环境变量示例
#
# 使用方式：复制为 .env 后修改（docker compose 会自动读取同目录下的 .env）
#     cp .env.example .env
#
# .env 已被 .gitignore 忽略，不会被提交。

# ── 必填 ─────────────────────────────────────────────────────────────────────
# JWT 签名密钥，至少 32 个字符。未提供时服务端启动即失败（不会退回默认密钥）。
# 生成方式（任选其一）：
#     openssl rand -hex 32
#     pwsh -Command "[guid]::NewGuid().ToString('N') + [guid]::NewGuid().ToString('N')"
ANYDROP_JWT_SECRET=

# ── 可选 ─────────────────────────────────────────────────────────────────────
# 镜像版本。填具体版本号可固定版本、随时回滚，例如 v1.2.3；
# 保持 latest 表示跟随最新发布。
ANYDROP_VERSION=latest

# 单文件上传大小上限（字节），默认 100 MB
ANYDROP_MAX_FILE_SIZE=104857600

# 登录令牌有效期（小时），默认 24
ANYDROP_TOKEN_EXPIRY_HOURS=24

# 是否允许回收「孤儿文件」（磁盘上存在、但数据库未引用的文件）。
# 默认 false：每天对账一次并写入日志，但只报告不删除。
# 确认日志中的报告无误后，可改为 true 以实际回收磁盘空间。
ANYDROP_ORPHAN_CLEANUP_ENABLED=false

# ── 反向代理（部署在 Nginx / Caddy / Traefik / Cloudflare 之后时启用）──────────
# 启用时必须同时填写代理网段，否则 X-Forwarded-* 会被忽略（安全默认值），
# 登录限流会退化成「所有访问者共享同一份配额」，一个人的失败会锁住所有人。
# 不要把网段写成 0.0.0.0/0 —— 那等于允许任何客户端伪造客户端 IP 绕过限流。
ANYDROP_REVERSE_PROXY_ENABLED=false
# 按实际代理网段填写，例如 Docker 默认的 172.16.0.0/12
ANYDROP_REVERSE_PROXY_NETWORK=
